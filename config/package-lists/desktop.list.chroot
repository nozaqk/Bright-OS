# =============================================================================
# Bright OS — Default Desktop Apps (layered on top of lightweight core)
#
# Phase 6.3: the heavy KDE Plasma stack has been removed from the default
# desktop. The default experience runs on labwc + Bright Shell (PyQt6/QML).
# This list adds user-facing apps that ship on the Home ISO.
#
# Heavy applications (LibreOffice, Thunderbird, GIMP, VLC, Wine, Dev tools,
# etc.) have been moved to edition-specific lists or optional profiles.
# Target: Debian 13 (Trixie) amd64
# =============================================================================

# --- Web browser (essential) ---
firefox-esr

# --- Media (lightweight defaults) ---
mpv
viewnior

# --- Lightweight image viewer / screenshot ---
screengrab
lximage-qt

# --- Calculator ---
galculator

# --- BitTorrent client (lightweight, CLI core) ---
transmission-cli
transmission-gtk

# --- Theme / style support for non-Qt apps ---
breeze-gtk-theme
gtk2-engines-murrine
