# =============================================================================
# Bright OS — Core System Packages (Phase 6.3 lightweight default)
#
# These packages are required for the default lightweight Bright OS image:
#   * Linux kernel + firmware
#   * systemd + essential CLI
#   * Networking (NetworkManager + iwd + wpa_supplicant + firewalld)
#   * Storage + Calamares installer
#   * Wayland + labwc compositor (default)
#   * greetd + gtkgreet lightweight display manager
#   * PyQt6 / Qt6 runtime for the Bright Desktop Shell
#   * PipeWire audio
#   * Minimal icon/font set
#   * Essential utilities
#
# Heavy components moved to OPTIONAL profiles:
#   * sddm + kwin-wayland (full KDE compositor/DM) → optional-recovery-kwin
#   * Bluetooth, printing, VPN/WWAN, mDNS, Wine, Dev tools, QEMU, Plymouth,
#     Secure Boot shim → optional-*.list.chroot
#   * AURA and Bright Android packages are kept as core because they add
#     almost no space (they are mostly Python scripts) and their services
#     are on-demand only (no boot-time cost).
#
# Target: Debian 13 (Trixie) amd64
# =============================================================================

# --- Kernel and firmware (keep all for broad USB/hardware support) ---
linux-image-amd64
firmware-linux
firmware-linux-nonfree
firmware-misc-nonfree
firmware-realtek
firmware-iwlwifi
firmware-atheros
firmware-brcm80211
# firmware-intelwimax removed in Trixie (Intel WiMAX EOL; hardware no longer supported)
initramfs-tools
cryptsetup-initramfs

# --- Core system ---
systemd
systemd-sysv
dbus
dbus-user-session
udev
util-linux
coreutils
bash
bash-completion
apt
apt-utils
apt-transport-https
dpkg
debconf
locales
tzdata
keyboard-configuration
console-setup
console-setup-linux
sudo
polkitd
pkexec
polkit-kde-agent-1
# policykit-1 meta + policykit-1-gnome removed in Trixie; polkit-kde-agent-1 is our graphical agent
pciutils
usbutils
kmod
ca-certificates
gnupg
lsb-release
man-db

# --- Networking (lightweight but fully functional) ---
network-manager
wireless-tools
wpasupplicant
wl-clipboard
jq
iwd
iproute2
iputils-ping
net-tools
dnsmasq-base
firewalld
openssh-client
curl
wget

# --- Storage and filesystems (needed for live + install) ---
parted
dosfstools
ntfs-3g
e2fsprogs
xfsprogs
btrfs-progs
udisks2
lvm2
cryptsetup
exfatprogs
fuse3
gvfs
gvfs-backends
gvfs-fuse
keyutils

# --- Display server: Wayland native + XWayland for X11 apps ---
xwayland
# Minimal X server drivers (avoid xserver-xorg-video-all which pulls in many
# legacy drivers: vmware, qxl, cirrus, fbdev, nouveau, ati, radeon, vesa…).
# The -modesetting driver is built into xserver-xorg-core.
xserver-xorg-core
xserver-xorg-input-libinput
xserver-xorg-video-amdgpu
xserver-xorg-video-intel
mesa-utils
mesa-va-drivers
mesa-vdpau-drivers
mesa-vulkan-drivers

# --- Display manager: greetd + gtkgreet (lightweight, ~5 MB vs SDDM ~120 MB) ---
# cage is the kiosk compositor that hosts gtkgreet on the login screen.
# (greetd itself is just a session daemon; it needs a Wayland compositor to
# display the greeter on.)
greetd
gtkgreet
cage

# --- Default Wayland compositor: labwc (wlroots, ~5 MB resident) ---
labwc
# Qt layer-shell integration so the PyQt6 Bright Shell becomes a proper
# wlr-layer-shell surface (panels/docks reserve an exclusive zone)
layer-shell-qt
qml6-module-org-kde-layershell
# XDG portal for wlroots (screenshots, screencopy, screen casting)
xdg-desktop-portal-wlr
# Notifications daemon (lightweight, Wayland native; no notify-osd/KNotify)
mako-notifier
# Screen lock / idle (lightweight; no KDE screenlocker)
swaylock
swayidle
# Multi-monitor / HiDPI profiles
kanshi
# Screenshot helpers
grim
slurp
# Output/brightness/keyboard tools
brightnessctl

