# =============================================================================
# AURA Core — Native Intelligence Platform (Foundation Packages)
# Phase 6.3: trimmed to only packages NOT already pulled in by core.list.chroot.
# AURA Core runs WITHOUT AI models and WITHOUT internet, providing security
# monitoring and service management. Activation is strictly on-demand via
# D-Bus (see config/includes.chroot/etc/systemd/system/aura-core.service);
# it does NOT start at boot.
# Target: Debian 13 (Trixie) amd64
# =============================================================================

# --- Polkit GObject Introspection (needed for authorization checks) ---
# policykit-1 + policykit-1-gnome already ship in core; this GIR binding is
# specific to AURA's polkit integration.
gir1.2-polkit-1.0

# --- Security monitoring ---
# AppArmor is enabled in the kernel by default on Debian Trixie;
# apparmor-utils is a small admin helper (aa-status, aa-enforce).
apparmor-utils
auditd
inotify-tools

# --- Firewalling (nftables CLI; firewalld is already in core) ---
nftables
iptables
