# =============================================================================
# Bright OS — Android Application Support (Bright Android)
# Waydroid-based Android runtime for running Android applications.
# Included in Home and Developer editions; available but not preinstalled
# in Lite (user must install waydroid manually).
# Target: Debian 13 (Trixie) amd64
# =============================================================================

# --- Waydroid runtime (pulls in lxc, python3, etc. as deps) ---
waydroid

# --- Binder kernel module (DKMS) for kernels without CONFIG_ANDROID_BINDER_IPC ---
# On standard Debian kernels, this package provides binder_linux.ko.
binder-linux-module-dkms

# --- ADB / fastboot for developer tools ---
adb
fastboot

# --- Clipboard integration for Wayland ---
wl-clipboard

# --- For .desktop file database updates ---
desktop-file-utils

# --- Image download and TLS ---
ca-certificates
