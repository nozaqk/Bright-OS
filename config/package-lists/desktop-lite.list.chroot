# =============================================================================
# Bright OS — Lite Desktop Packages
# Lightweight alternatives to the full KDE Plasma desktop for the Lite edition.
# These replace desktop.list.chroot when building the Lite edition.
#
# Key differences from desktop.list.chroot:
# - No plasma-desktop or plasma-workspace (saves ~500MB)
# - Uses Openbox as window manager instead of full KWin desktop shell
# - Uses GTK/lighter alternatives for tray applets
# - LXQt components where lighter than Plasma equivalents
# - KWin is still installed (from core) for Wayland, but not full Plasma
# =============================================================================

# --- LXQt core components (lighter panel/settings than Plasma) ---
lxqt-core
lxqt-themes
lxqt-about
lxqt-config
lxqt-policykit
lxqt-powermanagement
lxqt-runner
lxqt-session
lxqt-globalkeys
lxqt-notificationd

# --- Lightweight window manager for X11 fallback ---
openbox
obconf

# --- Compositor for X11 transparency (replaces KWin effects in Lite) ---
picom

# --- Lightweight file manager ---
pcmanfm-qt
lximage-qt

# --- Lightweight terminal ---
qterminal

# --- Lightweight text editor ---
featherpad

# --- System tray applets (lightweight, GTK-based) ---
network-manager-gnome
blueman
pavucontrol-qt
volumeicon-alsa

# --- Power management (lighter than powerdevil) ---
xfce4-power-manager

# --- Breeze cursor theme only (not full breeze-gtk-theme to save space) ---
breeze-cursor-theme
breeze-icon-theme

# --- Theme support for Qt apps (still needed for Bright Desktop) ---
qt5ct

# --- XDG portal for non-Plasma sessions ---
xdg-desktop-portal-gtk

# --- Essential printing (lite) ---
cups-bsd

# --- Bluetooth support (lite, via blueman not bluedevil) ---
bluez

# --- Archive support ---
engrampa
