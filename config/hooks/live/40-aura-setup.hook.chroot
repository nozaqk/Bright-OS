#!/bin/bash
# =============================================================================
# AURA subsystem installation hook (chroot hook)
# Runs during live-build chroot phase to apply sysusers/tmpfiles, install
# the AURA configuration, enable the systemd service, and set permissions.
#
# The AURA Python source tree is placed at /usr/lib/aura/ by build.sh
# BEFORE calling lb config (it copies ${PROJECT_ROOT}/aura/ into
# config/includes.chroot/usr/lib/aura/), so live-build already lays down
# the full tree. This hook does not need to copy source.
# =============================================================================
set -e

echo "I: Installing AURA subsystem..." | systemd-cat -t bright-os-aura -p info

AURA_USER="aura"
AURA_SRC="/usr/lib/aura"

# --- Ensure /usr/lib/aura exists (build.sh should have populated it) ---
mkdir -p "$AURA_SRC"

# --- Apply sysusers.d (creates 'aura' user/group) ---
# Files ship in /usr/lib/sysusers.d/ (standard location) so systemd-sysusers
# auto-applies them at boot/install; apply now during image build too.
if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/aura.conf 2>/dev/null || true
fi

# Fallback: create user manually if sysusers didn't run (e.g. host lacks systemd)
if ! id "$AURA_USER" >/dev/null 2>&1; then
    echo "I: Creating aura system user via useradd (fallback)..." | systemd-cat -t bright-os-aura -p info
    useradd --system \
            --no-create-home \
            --home-dir /var/lib/aura \
            --shell /usr/sbin/nologin \
            --user-group \
            --comment "Bright OS AURA Assistant" \
            "$AURA_USER" 2>/dev/null || true
fi

# --- Apply tmpfiles.d (creates /var/lib/aura, /var/log/aura with perms) ---
if command -v systemd-tmpfiles >/dev/null 2>&1; then
    systemd-tmpfiles --create /usr/lib/tmpfiles.d/aura.conf 2>/dev/null || true
fi

# --- Ensure config directory and file exist ---
mkdir -p /etc/bright-os/aura
chmod 0755 /etc/bright-os/aura
if [ ! -f /etc/bright-os/aura/aura.conf ]; then
    cp /usr/share/aura/aura.conf.default /etc/bright-os/aura/aura.conf 2>/dev/null || true
fi
chmod 0644 /etc/bright-os/aura/aura.conf 2>/dev/null || true

# --- Ensure Python module is importable ---
touch "$AURA_SRC/__init__.py" 2>/dev/null || true

# --- Make launcher executable ---
chmod +x /usr/bin/aura-core-service 2>/dev/null || true

# --- Install D-Bus and Polkit configs ---
# The dbus policy file ships in /etc/dbus-1/system.d/ via includes.chroot.
# Reload dbus config if running in a build chroot (dbus may not be active
# here; ignore failures).
if [ -d /etc/dbus-1/system.d ]; then
    # Files already in place via includes.chroot; nothing to copy.
    true
fi
# Polkit policy ships in /usr/share/polkit-1/actions/ via includes.chroot.
if [ -d /usr/share/polkit-1/actions ]; then
    : # already in place
fi

# --- Enable systemd service ---
if [ -d /etc/systemd/system ]; then
    systemctl enable aura-core.service 2>/dev/null || true
    echo "I: aura-core.service enabled" | systemd-cat -t bright-os-aura -p info
fi

echo "I: AURA subsystem installation complete." | systemd-cat -t bright-os-aura -p info
