#!/bin/sh
# Bright OS component installation hook
# Runs during live-build to install our custom applications and shell into the image
set -e

echo "Installing Bright OS components into live image..."

# Create directories
mkdir -p /usr/share/bright-os/shell
mkdir -p /usr/share/bright-os/icons
mkdir -p /usr/share/bright-os/wallpapers
mkdir -p /usr/share/bright-os/themes/dark
mkdir -p /usr/share/bright-os/themes/light
mkdir -p /usr/share/bright-os/design
mkdir -p /usr/share/bright-os/profiles
mkdir -p /usr/share/bright-os/installer
mkdir -p /usr/lib/bright-os
mkdir -p /etc/bright-os
mkdir -p /etc/calamares/modules
mkdir -p /etc/calamares/branding/bright-os
mkdir -p /usr/share/plymouth/themes/bright-os
mkdir -p /boot/grub/themes/bright-os
mkdir -p /usr/share/desktop-directories
mkdir -p /etc/skel/Desktop
mkdir -p /etc/skel/.config/qt6ct/colors
mkdir -p /etc/skel/.config/qt5ct/colors
mkdir -p /etc/skel/.config/KDE
mkdir -p /etc/xdg/autostart

# Copy shell
cat > /usr/bin/bright-desktop-shell << 'SHELL_SCRIPT'
#!/bin/bash
exec python3 /usr/share/bright-os/bright-desktop-shell.py "$@"
SHELL_SCRIPT
chmod 755 /usr/bin/bright-desktop-shell

# The actual Python shell and QML will be installed via the install script
# that runs during build. Here we ensure they exist.

# Copy wallpapers
# (Done via config/includes.chroot in live-build)

# Set edition
BRIGHT_EDITION=$(cat /etc/bright-os/edition 2>/dev/null || echo "home")

# Edition-specific shell defaults
case "$BRIGHT_EDITION" in
    developer)
        DEFAULT_PANEL_HEIGHT=36
        DEFAULT_DOCK_ICON_SIZE=40
        DEFAULT_DOCK_POSITION="left"
        DEFAULT_ANIMATIONS="true"
        ;;
    lite)
        DEFAULT_PANEL_HEIGHT=28
        DEFAULT_DOCK_ICON_SIZE=32
        DEFAULT_DOCK_POSITION="none"
        DEFAULT_ANIMATIONS="false"
        ;;
    home|*)
        DEFAULT_PANEL_HEIGHT=40
        DEFAULT_DOCK_ICON_SIZE=48
        DEFAULT_DOCK_POSITION="bottom"
        DEFAULT_ANIMATIONS="true"
        ;;
esac

# Create skel config
mkdir -p /etc/skel/.config/bright-os
cat > /etc/skel/.config/bright-os/shell.conf << EOF
# Bright OS Shell Configuration
# Edition: ${BRIGHT_EDITION}
theme=dark
wallpaper=/usr/share/bright-os/wallpapers/bright-default-dark.svg
panel_position=$([ "$BRIGHT_EDITION" = "lite" ] && echo "bottom" || echo "top")
panel_height=${DEFAULT_PANEL_HEIGHT}
dock_position=${DEFAULT_DOCK_POSITION}
dock_icon_size=${DEFAULT_DOCK_ICON_SIZE}
dock_auto_hide=false
animations=${DEFAULT_ANIMATIONS}
EOF

# --- Display manager config -----------------------------------------------
# Phase 6.3: greetd is the default DM. If SDDM is present (optional-recovery-
# kwin profile), write a minimal config so manual `systemctl start sddm`
# still works, but leave it disabled (display-manager.service symlinks to
# greetd; see hook 15-display-manager).
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/bright-live.conf << 'EOF'
[Theme]
Current=breeze
CursorTheme=breeze_cursors

[Wayland]
EnableHiDPI=true

[X11]
EnableHiDPI=true
EOF

# Greetd config dir (config is provided by includes.chroot/etc/greetd/config.toml)
mkdir -p /etc/greetd

# Autologin for the live user is configured by lib/live/config/05-bright-os
# at boot time (not baked into the image).

# Sysctl hardening is provided by includes.chroot/etc/sysctl.d/99-bright-os-sysctl.conf
# NetworkManager config is provided by includes.chroot/etc/NetworkManager/conf.d/99-bright-os-network.conf

# --- Enable essential services --------------------------------------------
systemctl enable NetworkManager.service 2>/dev/null || true
systemctl enable firewalld.service 2>/dev/null || true
systemctl enable udisks2.service 2>/dev/null || true
systemctl enable bright-os-firstboot.service 2>/dev/null || true

# Enable greetd (lightweight DM) if present.
if [ -x /usr/sbin/greetd ]; then
    systemctl enable greetd.service 2>/dev/null || true
fi

# --- Optional services ----------------------------------------------------
# build.sh masked services whose feature was OFF by symlinking the unit
# file to /dev/null in config/includes.chroot/etc/systemd/system/. If a
# service was enabled (feature ON), no mask was placed, but we still need
# to explicitly enable the service here. We unmask first (defensive), then
# enable — but only enable when the corresponding binary is actually
# installed (i.e. the optional package list was included in this build).
#
# Using systemctl unmask before enable is harmless if there is no mask; it
# ensures enable+start work correctly.
enable_optional_svc() {
    local svc="$1"; local binary="$2"
    if [ -n "$binary" ] && ! command -v "$binary" >/dev/null 2>&1; then
        # Feature package list was NOT included; ensure service stays masked.
        return 0
    fi
    systemctl unmask "$svc" 2>/dev/null || true
    systemctl enable "$svc" 2>/dev/null || true
}

if command -v bluetoothd >/dev/null 2>&1; then
    # Check that we did NOT mask bluetooth (i.e. feature is enabled for this build).
    if [ ! -L /etc/systemd/system/bluetooth.service ] || \
       [ "$(readlink -f /etc/systemd/system/bluetooth.service 2>/dev/null)" != "/dev/null" ]; then
        enable_optional_svc bluetooth.service bluetoothd
    fi
fi
if [ -x /usr/sbin/cupsd ]; then
    if [ ! -L /etc/systemd/system/cups.service ] || \
       [ "$(readlink -f /etc/systemd/system/cups.service 2>/dev/null)" != "/dev/null" ]; then
        enable_optional_svc cups.service cupsd
    fi
fi
if [ -x /usr/sbin/ModemManager ] || [ -f /usr/sbin/ModemManager ]; then
    if [ ! -L /etc/systemd/system/ModemManager.service ] || \
       [ "$(readlink -f /etc/systemd/system/ModemManager.service 2>/dev/null)" != "/dev/null" ]; then
        enable_optional_svc ModemManager.service ModemManager
    fi
fi
if [ -x /usr/sbin/avahi-daemon ]; then
    if [ ! -L /etc/systemd/system/avahi-daemon.service ] || \
       [ "$(readlink -f /etc/systemd/system/avahi-daemon.service 2>/dev/null)" != "/dev/null" ]; then
        enable_optional_svc avahi-daemon.service avahi-daemon
    fi
fi

systemctl set-default graphical.target 2>/dev/null || true

# --- Install labwc system-wide configuration -----------------------------
# These are the Bright defaults; users can override in ~/.config/labwc/.
if [ -d /usr/share/bright-os/labwc ] || [ -d /usr/share/bright-os/session/labwc ]; then
    LABWC_DEST="/usr/share/bright-os/labwc"
    mkdir -p "$LABWC_DEST"
    # The build.sh copies desktop/session/labwc/* into config/includes.chroot
    # before hooks run; if files are already in /usr/share/bright-os/labwc/,
    # don't overwrite (build.sh's copy is authoritative).
    for f in /usr/share/bright-os/session/labwc/*; do
        [ -f "$f" ] && cp -n "$f" "$LABWC_DEST/" 2>/dev/null || true
    done
    chmod 0755 "$LABWC_DEST/autostart" 2>/dev/null || true
fi

# Apply firewall defaults
if command -v firewall-cmd &>/dev/null; then
    firewall-cmd --permanent --add-service=ssh 2>/dev/null || true
    firewall-cmd --permanent --add-service=dhcpv6-client 2>/dev/null || true
fi

# === Install Calamares configuration ===
if [ -d /usr/share/bright-os/installer ]; then
    cp -f /usr/share/bright-os/installer/settings.conf /etc/calamares/settings.conf 2>/dev/null || true
    cp -f /usr/share/bright-os/installer/modules/*.conf /etc/calamares/modules/ 2>/dev/null || true
    chmod +x /usr/share/bright-os/installer/postcfg.sh 2>/dev/null || true
    if [ -d /usr/share/bright-os/installer/branding ]; then
        cp -rf /usr/share/bright-os/installer/branding/* /etc/calamares/branding/ 2>/dev/null || true
    fi
fi

# === Install Plymouth theme ===
# NOTE: Do NOT run update-initramfs here. live-build builds the final initramfs
# after ALL hooks run. Plymouth default theme is set in hook 20.
if [ -d /usr/share/bright-os/plymouth ]; then
    cp -rf /usr/share/bright-os/plymouth/* /usr/share/plymouth/themes/bright-os/ 2>/dev/null || true
fi

# === Install GRUB theme (for installed system) ===
if [ -d /usr/share/bright-os/grub ]; then
    cp -rf /usr/share/bright-os/grub/* /boot/grub/themes/bright-os/ 2>/dev/null || true
fi

# === Install Qt6ct default theme (dark) ===
if [ -f /usr/share/bright-os/themes/dark/qt6ct.conf ]; then
    cp -f /usr/share/bright-os/themes/dark/qt6ct.conf /etc/skel/.config/qt6ct/qt6ct.conf 2>/dev/null || true
fi
if [ -f /usr/share/bright-os/themes/dark/colors.conf ]; then
    cp -f /usr/share/bright-os/themes/dark/colors.conf /etc/skel/.config/qt6ct/colors/bright-dark.conf 2>/dev/null || true
fi

# === Make sure live user has install icon on desktop ===
chmod +x /etc/skel/Desktop/install-bright-os.desktop 2>/dev/null || true
chmod +x /home/user/Desktop/install-bright-os.desktop 2>/dev/null || true

# === Add user to required groups ===
for g in dialout plugdev kvm docker; do
    addgroup --system $g 2>/dev/null || true
done
# live user already exists; ensure groups
if id user &>/dev/null; then
    for g in dialout plugdev kvm docker; do
        adduser user $g 2>/dev/null || true
    done
fi

echo "Bright OS components installed (edition: ${BRIGHT_EDITION})"
