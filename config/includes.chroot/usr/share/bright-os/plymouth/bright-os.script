// Bright OS Plymouth Boot Theme
// Minimal script-based theme - uses only primitive drawing ops
// that work reliably across all Plymouth versions

// State
progress = 0.0;
dot_phase = 0;

fun draw_background() {
    // Solid dark background
    Plymouth.Draw.Box(0, 0, Window.GetWidth(), Window.GetHeight(),
                      0.039, 0.055, 0.102, 1.0);
}

fun draw_logo_box() {
    // Bright OS "sun" logo drawn as concentric squares and center dot
    var cx = Window.GetWidth() / 2;
    var cy = Window.GetHeight() / 2 - 40;
    var s = 70;
    
    // Outer ring - rendered as square border approximation
    // Draw top/bottom/left/right edges of the "sun"
    Plymouth.Draw.Box(cx - s, cy - 2, s*2, 4,
                      0.231, 0.510, 0.965, 0.8);  // top ray
    Plymouth.Draw.Box(cx - 2, cy - s, 4, s*2,
                      0.231, 0.510, 0.965, 0.8);  // bottom ray
    Plymouth.Draw.Box(cx - s, cy - s, s*2, 4,
                      0.231, 0.510, 0.965, 0.3);  // top
    Plymouth.Draw.Box(cx - s, cy + s - 4, s*2, 4,
                      0.231, 0.510, 0.965, 0.3);  // bottom
    Plymouth.Draw.Box(cx - s, cy - s, 4, s*2,
                      0.231, 0.510, 0.965, 0.3);  // left
    Plymouth.Draw.Box(cx + s - 4, cy - s, 4, s*2,
                      0.231, 0.510, 0.965, 0.3);  // right
    
    // Inner square
    var is = 36;
    Plymouth.Draw.Box(cx - is, cy - is, is*2, 2,
                      0.388, 0.400, 0.945, 0.6);
    Plymouth.Draw.Box(cx - is, cy + is - 2, is*2, 2,
                      0.388, 0.400, 0.945, 0.6);
    Plymouth.Draw.Box(cx - is, cy - is, 2, is*2,
                      0.388, 0.400, 0.945, 0.6);
    Plymouth.Draw.Box(cx + is - 2, cy - is, 2, is*2,
                      0.388, 0.400, 0.945, 0.6);
    
    // Center glow
    Plymouth.Draw.Box(cx - 20, cy - 20, 40, 40,
                      0.945, 0.961, 0.976, 0.95);
    Plymouth.Draw.Box(cx - 12, cy - 12, 24, 24,
                      0.576, 0.647, 0.988, 0.7);
    Plymouth.Draw.Box(cx - 5, cy - 5, 10, 10,
                      1.0, 1.0, 1.0, 1.0);
}

fun draw_loading_dots() {
    // Animated loading dots
    var cx = Window.GetWidth() / 2;
    var cy = Window.GetHeight() / 2 + 80;
    var dot_spacing = 20;
    var dot_size = 8;
    var i;
    var dots_start = cx - dot_spacing * 2;
    
    for (i = 0; i < 5; i++) {
        var offset = (dot_phase + i) % 5;
        var opacity = 0.2 + (0.16 * (5 - offset));
        if (opacity > 0.9) opacity = 0.9;
        var x = dots_start + i * dot_spacing;
        var y = cy;
        // Dot
        Plymouth.Draw.Box(x - dot_size/2, y - dot_size/2, dot_size, dot_size,
                          0.231, 0.510, 0.965, opacity);
    }
}

fun draw_title() {
    var cx = Window.GetWidth() / 2;
    var cy = Window.GetHeight() / 2 + 30;
    
    Plymouth.Draw.Text("BRIGHT OS",
                       cx - 100, cy, 200, 30,
                       "DejaVu Sans Bold 24",
                       0.945, 0.961, 0.976, 1.0);
}

fun draw_progress() {
    var cx = Window.GetWidth() / 2;
    var cy = Window.GetHeight() / 2 + 130;
    var pw = 320;
    var ph = 3;
    var px = cx - pw/2;
    
    // Background
    Plymouth.Draw.Box(px, cy, pw, ph,
                      0.118, 0.161, 0.231, 1.0);
    // Progress fill
    var prog = Plymouth.GetProgress();
    if (prog < 0) prog = 0;
    if (prog > 1) prog = 1;
    if (prog > 0.01) {
        Plymouth.Draw.Box(px, cy, pw * prog, ph,
                          0.231, 0.510, 0.965, 1.0);
    }
}

fun draw_password() {
    // Password entry for LUKS
    var bullets = Plymouth.GetPasswordBulletCount();
    if (bullets > 0) {
        var cx = Window.GetWidth() / 2;
        var cy = Window.GetHeight() / 2 + 160;
        Plymouth.Draw.Text("Encrypted disk password:",
                           cx - 150, cy, 300, 24,
                           "DejaVu Sans 13",
                           0.8, 0.85, 0.95, 1.0);
        var j;
        for (j = 0; j < bullets; j++) {
            Plymouth.Draw.Box(cx - 50 + j * 18, cy + 30, 10, 10,
                              0.231, 0.510, 0.965, 1.0);
        }
    }
}

fun draw_message() {
    var msg = Plymouth.GetMessage();
    if (msg && msg != "") {
        var cx = Window.GetWidth() / 2;
        var cy = Window.GetHeight() - 80;
        var tw = 400;
        Plymouth.Draw.Text(msg, cx - tw/2, cy, tw, 24,
                           "DejaVu Sans 11",
                           0.4, 0.45, 0.55, 1.0);
    }
}

// Refresh callback - called ~30fps
fun refresh_callback() {
    draw_background();
    draw_logo_box();
    draw_title();
    draw_loading_dots();
    draw_progress();
    draw_password();
    draw_message();
    
    dot_phase = dot_phase + 0.2;
    if (dot_phase > 5) dot_phase = 0;
}

Plymouth.SetRefreshFunction(refresh_callback);
