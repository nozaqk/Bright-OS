#!/bin/bash
# =============================================================================
# Bright Desktop Shell entry point (Phase 6.3)
#
# Default: labwc Wayland compositor with the Bright PyQt6/QML shell.
# Fallback: kwin_wayland (if installed via optional-recovery-kwin) or X11.
#
# Usage:
#   bright-desktop-shell              # auto-detect best compositor
#   bright-desktop-shell --labwc      # force labwc
#   bright-desktop-shell --kwin       # force kwin_wayland
#   bright-desktop-shell --shell-only # run the Python shell directly
#                                     (used inside an already-running
#                                     compositor, e.g. kwin_wayland's
#                                     --exit-with-session)
# =============================================================================

set -e

# Update XDG user dirs early
if [ -x /usr/bin/xdg-user-dirs-update ]; then
    xdg-user-dirs-update --force >/dev/null 2>&1 || true
fi

export XDG_CURRENT_DESKTOP=Bright:labwc
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=Fusion
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
export DESKTOP_SESSION=bright

# Ensure XDG_RUNTIME_DIR exists
: "${XDG_RUNTIME_DIR:=/run/user/$(id -u)}"
export XDG_RUNTIME_DIR
mkdir -p "$XDG_RUNTIME_DIR" 2>/dev/null || true

# If we're being called with --shell-only, exec the Python shell directly
# (kwin_wayland --exit-with-session and labwc autostart use this mode).
if [ "$1" = "--shell-only" ]; then
    exec python3 /usr/share/bright-os/bright-desktop-shell.py "$@"
fi

# Force-selection flags
if [ "$1" = "--labwc" ]; then
    export BRIGHT_SHELL_COMPOSITOR=labwc
    exec /usr/share/bright-os/bright-desktop-session-labwc.sh
fi
if [ "$1" = "--kwin" ]; then
    export BRIGHT_SHELL_COMPOSITOR=kwin
    exec /usr/share/bright-os/bright-desktop-session.sh
fi

# Auto-detect: prefer labwc if available, fall back to kwin_wayland, then
# fall back to running the shell bare (on an existing compositor / X11).
if command -v labwc >/dev/null 2>&1 && [ "${XDG_SESSION_TYPE}" = "wayland" ] \
   && [ -z "${BRIGHT_COMPOSITOR_STARTED}" ]; then
    export BRIGHT_COMPOSITOR_STARTED=1
    exec /usr/share/bright-os/bright-desktop-session-labwc.sh
elif command -v kwin_wayland >/dev/null 2>&1 && [ "${XDG_SESSION_TYPE}" = "wayland" ] \
     && [ -z "${BRIGHT_COMPOSITOR_STARTED}" ]; then
    export BRIGHT_COMPOSITOR_STARTED=1
    export XDG_CURRENT_DESKTOP=Bright:KDE
    exec kwin_wayland --no-lockscreen --exit-with-session="/usr/bin/bright-desktop-shell --shell-only"
else
    # Already inside a compositor, or running on X11: just launch the shell.
    exec python3 /usr/share/bright-os/bright-desktop-shell.py "$@"
fi
