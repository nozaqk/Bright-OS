#!/bin/bash
# Bright Desktop KWin recovery wrapper
#
# Used only by bright-kwin.desktop (generated by 00-sessions hook when
# kwin_wayland is installed). Sets up environment then delegates to the
# KWin session script which execs kwin_wayland with the Bright shell embedded.
#
# Phase 6.3: The default labwc session is bright.desktop ->
#   /usr/share/bright-os/bright-desktop-session-labwc.sh
# This wrapper is kept solely for KWin recovery.

export XDG_CURRENT_DESKTOP=Bright:KDE
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-wayland}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=Fusion
export QT_AUTO_SCREEN_SCALE_FACTOR=1

# GTK theming
export GTK_THEME=Breeze-Dark
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24

# Sound server
export PIPEWIRE_LATENCY=128/48000

# User directories
[ -x /usr/bin/xdg-user-dirs-update ] && xdg-user-dirs-update --force

# Start keyring
if command -v gnome-keyring-daemon &>/dev/null; then
    eval "$(gnome-keyring-daemon --start --components=secrets,ssh,pkcs11)"
    export SSH_AUTH_SOCK
fi

exec /usr/share/bright-os/bright-desktop-session.sh
