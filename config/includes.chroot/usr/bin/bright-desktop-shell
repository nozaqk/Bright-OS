#!/bin/bash
# Bright Desktop session wrapper
#
# Default entry point for both Wayland (bright.desktop in wayland-sessions)
# and X11 (bright.desktop in xsessions). Sets up environment and dispatches
# to the correct compositor/session based on what's available and the
# XDG_SESSION_TYPE.
#
# Phase 6.3 default compositor is labwc (lightweight wlroots). KWin is
# kept as a selectable recovery session via bright-kwin.desktop, which
# sets BRIGHT_COMPOSITOR=kwin to force KWin.
#
# Session dispatch priority:
#   1. BRIGHT_COMPOSITOR=kwin  -> KWin recovery (bright-kwin.desktop)
#   2. Wayland + labwc         -> labwc (default)
#   3. Wayland + kwin_wayland  -> KWin fallback (if labwc missing)
#   4. X11 + openbox           -> Openbox + shell directly (lite/X11 fallback)
#   5. Anything else           -> Bright shell directly on existing display

# --- Session identity -----------------------------------------------------
if [ -z "${XDG_SESSION_TYPE:-}" ]; then
    if [ -n "${WAYLAND_DISPLAY:-}" ]; then
        export XDG_SESSION_TYPE=wayland
    elif [ -n "${DISPLAY:-}" ]; then
        export XDG_SESSION_TYPE=x11
    else
        export XDG_SESSION_TYPE=wayland
    fi
fi

export XDG_CURRENT_DESKTOP=Bright
export DESKTOP_SESSION=bright

# --- Qt / GTK / cursor / audio common env --------------------------------
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export QT_QPA_PLATFORMTHEME=qt6ct
export QT_STYLE_OVERRIDE=Fusion
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export GTK_THEME=Breeze-Dark
export XCURSOR_THEME=breeze_cursors
export XCURSOR_SIZE=24
export PIPEWIRE_LATENCY=128/48000

# Detect edition
EDITION=$(cat /etc/bright-os/edition 2>/dev/null || echo "home")
if [ "$EDITION" = "lite" ]; then
    export QT_QUICK_CONTROLS_STYLE=Basic
    export QSG_RENDER_LOOP=basic
    export QT_AUTO_SCREEN_SCALE_FACTOR=0
    export XCURSOR_SIZE=16
fi

# User directories
[ -x /usr/bin/xdg-user-dirs-update ] && xdg-user-dirs-update --force

# Keyring
if command -v gnome-keyring-daemon &>/dev/null; then
    eval "$(gnome-keyring-daemon --start --components=secrets,ssh,pkcs11)"
    export SSH_AUTH_SOCK
fi

# --- Dispatch -------------------------------------------------------------
if [ "${BRIGHT_COMPOSITOR:-}" = "kwin" ] && command -v kwin_wayland &>/dev/null \
   && [ "$XDG_SESSION_TYPE" = "wayland" ]; then
    # Forced KWin recovery session
    export XDG_CURRENT_DESKTOP=Bright:KDE
    exec /usr/share/bright-os/bright-desktop-session.sh

elif [ "$XDG_SESSION_TYPE" = "wayland" ] && command -v labwc &>/dev/null; then
    # Default labwc session
    exec /usr/share/bright-os/bright-desktop-session-labwc.sh

elif [ "$XDG_SESSION_TYPE" = "wayland" ] && command -v kwin_wayland &>/dev/null; then
    # Fallback KWin if labwc missing
    export XDG_CURRENT_DESKTOP=Bright:KDE
    exec /usr/share/bright-os/bright-desktop-session.sh

elif [ "$XDG_SESSION_TYPE" = "x11" ] && command -v openbox &>/dev/null; then
    # X11 fallback (lite)
    if [ "$EDITION" = "lite" ]; then
        openbox --replace &
    fi
    exec /usr/share/bright-os/bright-desktop-shell.py

else
    # Last resort: run shell directly on whatever display exists
    exec /usr/share/bright-os/bright-desktop-shell.py
fi
