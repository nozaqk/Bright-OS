#!/usr/bin/env python3
"""
Bright Control Center - System administration hub
Firewall, users, services, backups, disks, updates
"""
import sys
import subprocess
from PyQt6.QtWidgets import *
from PyQt6.QtCore import Qt, QTimer

APP_NAME = "Bright Control Center"
STYLE = """
QMainWindow, QWidget { background: #0f172a; color: #e2e8f0; font-size: 13px; }
QListWidget { background: #1e293b; border: none; padding: 8px; }
QListWidget::item { padding: 12px; border-radius: 8px; margin-bottom: 2px; }
QListWidget::item:selected { background: #3b82f6; color: white; }
QGroupBox { border: 1px solid #334155; border-radius: 10px; margin-top: 16px; padding: 16px; font-weight: bold; }
QGroupBox::title { left: 12px; padding: 0 8px; color: #94a3b8; }
QPushButton { background: #3b82f6; color: white; border: none; border-radius: 8px; padding: 8px 16px; }
QPushButton:hover { background: #2563eb; }
QPushButton#danger { background: #ef4444; }
QPushButton#danger:hover { background: #dc2626; }
QPushButton#success { background: #22c55e; }
QTextEdit { background: #0a0e1a; color: #94a3b8; border: 1px solid #334155; border-radius: 8px; font-family: 'Hack', monospace; padding: 8px; }
QLabel#title { font-size: 20px; font-weight: bold; }
QLabel#subtitle { color: #64748b; }
QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 18px; height: 18px; border-radius: 4px; border: 2px solid #475569; background: #1e293b; }
QCheckBox::indicator:checked { background: #3b82f6; border-color: #3b82f6; }
"""


class FirewallPage(QWidget):
    def __init__(self):
        super().__init__()
        lay = QVBoxLayout(self)
        title = QLabel("Firewall"); title.setObjectName("title"); lay.addWidget(title)
        sub = QLabel("Manage network firewall (firewalld)"); sub.setObjectName("subtitle"); lay.addWidget(sub)
        group = QGroupBox("Firewall Status")
        gl = QVBoxLayout(group)
        self.status = QLabel("Checking...")
        gl.addWidget(self.status)
        self.enable_btn = QPushButton("Enable Firewall"); self.enable_btn.clicked.connect(self.toggle)
        gl.addWidget(self.enable_btn)
        lay.addWidget(group)
        
        zgroup = QGroupBox("Active Zones")
        zl = QVBoxLayout(zgroup)
        self.zones_text = QTextEdit(); self.zones_text.setReadOnly(True); self.zones_text.setMaximumHeight(200)
        zl.addWidget(self.zones_text)
        lay.addWidget(zgroup)
        lay.addStretch()
        self.refresh()
    
    def refresh(self):
        try:
            r = subprocess.run(["firewall-cmd", "--state"], capture_output=True, text=True, timeout=5)
            self.status.setText(f"Status: {r.stdout.strip()}")
            r2 = subprocess.run(["firewall-cmd", "--get-active-zones"], capture_output=True, text=True, timeout=5)
            self.zones_text.setPlainText(r2.stdout if r2.returncode == 0 else "firewalld not running")
        except Exception:
            self.status.setText("firewalld not available")
    
    def toggle(self):
        subprocess.run(["pkexec", "firewall-cmd", "--reload"], capture_output=True)
        self.refresh()


class UsersPage(QWidget):
    def __init__(self):
        super().__init__()
        lay = QVBoxLayout(self)
        title = QLabel("User Accounts"); title.setObjectName("title"); lay.addWidget(title)
        sub = QLabel("Manage user accounts and permissions"); sub.setObjectName("subtitle"); lay.addWidget(sub)
        group = QGroupBox("Current Users")
        gl = QVBoxLayout(group)
        self.users_text = QTextEdit(); self.users_text.setReadOnly(True); self.users_text.setMaximumHeight(250)
        gl.addWidget(self.users_text)
        btn = QPushButton("Open User Settings"); btn.clicked.connect(lambda: subprocess.Popen(["users-admin"]))
        gl.addWidget(btn)
        lay.addWidget(group)
        lay.addStretch()
        try:
            r = subprocess.run(["getent", "passwd"], capture_output=True, text=True)
            users = [l for l in r.stdout.split("\n") if int(l.split(":")[2]) >= 1000 if ":" in l]
            self.users_text.setPlainText("\n".join(users))
        except Exception:
            self.users_text.setPlainText("Cannot list users")


class ServicesPage(QWidget):
    def __init__(self):
        super().__init__()
        lay = QVBoxLayout(self)
        title = QLabel("System Services"); title.setObjectName("title"); lay.addWidget(title)
        sub = QLabel("Manage systemd services"); sub.setObjectName("subtitle"); lay.addWidget(sub)
        btn = QPushButton("Open Service Manager"); btn.clicked.connect(lambda: subprocess.Popen(["systemsettings5"]))
        lay.addWidget(btn)
        group = QGroupBox("Key Services Status")
        gl = QVBoxLayout(group)
        self.svc_text = QTextEdit(); self.svc_text.setReadOnly(True)
        gl.addWidget(self.svc_text)
        lay.addWidget(group)
        lay.addStretch()
        services = ["NetworkManager", "sddm", "firewalld", "cups", "bluetooth", "udisks2", "upower"]
        statuses = []
        for svc in services:
            try:
                r = subprocess.run(["systemctl", "is-active", svc], capture_output=True, text=True, timeout=3)
                statuses.append(f"{svc:20s} {r.stdout.strip()}")
            except Exception:
                statuses.append(f"{svc:20s} unknown")
        self.svc_text.setPlainText("\n".join(statuses))


class BrightControlCenter(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.setMinimumSize(850, 600)
        self.setStyleSheet(STYLE)
        
        central = QWidget()
        self.setCentralWidget(central)
        h = QHBoxLayout(central); h.setContentsMargins(0,0,0,0); h.setSpacing(0)
        
        self.nav = QListWidget(); self.nav.setFixedWidth(200)
        pages = [
            ("\U0001F6E1\uFE0F  Firewall", FirewallPage),
            ("\uD83D\uDC65  Users", UsersPage),
            ("\u2699\uFE0F  Services", ServicesPage),
        ]
        stack = QStackedWidget()
        for name, cls in pages:
            self.nav.addItem(QListWidgetItem(name))
            scroll = QScrollArea(); scroll.setWidgetResizable(True); scroll.setWidget(cls())
            stack.addWidget(scroll)
        self.nav.currentRowChanged.connect(stack.setCurrentIndex)
        self.nav.setCurrentRow(0)
        
        h.addWidget(self.nav); h.addWidget(stack, 1)


def main():
    QApplication.setApplicationName("bright-control-center")
    QApplication.setApplicationDisplayName(APP_NAME)
    app = QApplication(sys.argv)
    w = BrightControlCenter(); w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
