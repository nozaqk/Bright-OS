#!/usr/bin/env python3
"""Launcher wrapper for the Bright Android management GUI and service.

Usage:
  bright-android                     Launch the GUI
  bright-android --service           Run the D-Bus service
  bright-android --launch <package>  Launch an installed Android app
  bright-android --install-apk <path> Install an APK

--launch and --install-apk go through the D-Bus service (see
bright_android/core/cli.py), so they use the same authorization as the GUI.
"""
import sys

# Library path: bright_android Python package lives under /usr/lib/
sys.path.insert(0, "/usr/lib")


def launch_gui():
    from bright_android.gui import main as gui_main
    return gui_main()


if __name__ == "__main__":
    args = sys.argv[1:]

    if "--service" in args:
        from bright_android.core.android_service import main as service_main
        sys.exit(service_main())

    if "--launch" in args or "--install-apk" in args:
        from bright_android.core.cli import run as cli_run
        sys.exit(cli_run(args))

    # Default: launch GUI
    sys.exit(launch_gui())
