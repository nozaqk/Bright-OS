#!/bin/sh
# Bright OS live system configuration hook
# Runs at boot time in the live environment (from live-config)
# Sets up live user, hostname, branding, and defaults

set -e

EDITION=$(cat /etc/bright-os/edition 2>/dev/null || echo "home")

echo "Bright OS: configuring live environment (edition: ${EDITION})"

# Set hostname
echo "bright-os" > /etc/hostname
hostname -F /etc/hostname 2>/dev/null || true

# Create the live user if not already created by live-boot
if ! id user &>/dev/null 2>&1; then
    useradd -m -s /bin/bash \
        -G sudo,audio,video,netdev,bluetooth,lp,scanner,dialout,plugdev,kvm,docker,input \
        user 2>/dev/null || true
    echo "user:live" | chpasswd 2>/dev/null || true
fi

# Ensure live user has proper groups (in case user already existed)
for g in sudo audio video netdev bluetooth lp scanner dialout plugdev kvm docker input; do
    adduser user "$g" 2>/dev/null || true
done

# Passwordless sudo for live user
cat > /etc/sudoers.d/bright-live << 'EOF'
user ALL=(ALL) NOPASSWD: ALL
EOF
chmod 440 /etc/sudoers.d/bright-live

# Copy skel files to user home if needed
if [ -d /home/user ]; then
    chown -R user:user /home/user 2>/dev/null || true
    # Install desktop shortcut
    if [ -f /etc/skel/Desktop/install-bright-os.desktop ]; then
        mkdir -p /home/user/Desktop
        cp /etc/skel/Desktop/install-bright-os.desktop /home/user/Desktop/
        chmod +x /home/user/Desktop/install-bright-os.desktop
        chown user:user /home/user/Desktop/install-bright-os.desktop
    fi
fi

# SDDM autologin for live session
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/bright-live-autologin.conf << EOF
[Autologin]
User=user
Session=bright.desktop
Relogin=true

[Theme]
Current=breeze
CursorTheme=breeze_cursors

[Wayland]
EnableHiDPI=true

[X11]
EnableHiDPI=true
EOF

# MOTD
cat > /etc/motd << EOF

Welcome to Bright OS ${EDITION^} Edition (Alpha)
===============================================

Default live user: user  /  password: live

To install Bright OS to your computer, double-click the
"Install Bright OS" icon on the desktop.

For documentation: https://github.com/nozaqk/Bright-OS
To report issues:   https://github.com/nozaqk/Bright-OS/issues

EOF

cat > /etc/issue << EOF
Bright OS \\l

EOF

# os-release
cat > /etc/os-release << EOF
PRETTY_NAME="Bright OS ${EDITION^} (Alpha)"
NAME="Bright OS"
VERSION_ID="0.1"
VERSION="0.1.0-alpha (${EDITION})"
VERSION_CODENAME=dawn
ID=bright
ID_LIKE=debian
HOME_URL="https://github.com/nozaqk/Bright-OS"
SUPPORT_URL="https://github.com/nozaqk/Bright-OS/issues"
BUG_REPORT_URL="https://github.com/nozaqk/Bright-OS/issues"
BRIGHT_EDITION="${EDITION}"
BRIGHT_VERSION="0.1.0-alpha"
DEBIAN_CODENAME=bookworm
EOF

# Ensure user config directories exist
mkdir -p /home/user/.config/bright-os
mkdir -p /home/user/.config/qt6ct
chown -R user:user /home/user/.config 2>/dev/null || true

# Default shell config
cat > /home/user/.config/bright-os/shell.conf << 'EOF'
# Bright OS Shell Configuration (live)
theme=dark
wallpaper=/usr/share/bright-os/wallpapers/bright-default-dark.svg
panel_height=40
dock_icon_size=48
dock_position=bottom
animations=true
EOF
chown user:user /home/user/.config/bright-os/shell.conf

# Configure Flathub (as user, not system, since system one may be done already)
if command -v flatpak &>/dev/null; then
    flatpak remote-add --if-not-exists --system flathub https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null || true
fi

# Make sure we're in graphical target (should already be set)
systemctl set-default graphical.target 2>/dev/null || true

echo "Bright OS live configuration complete."
