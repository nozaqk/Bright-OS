// Bright OS Plymouth Boot Splash
// A clean, minimal boot animation showing the Bright OS logo with spinner

fun refresh_callback() {
    // Rotation/spinner handled by system
}

// Logo
bright_logo.image = Image("bright-os-logo.png");
bright_logo.sprite = Sprite(bright_logo.image);
bright_logo.sprite.SetX(Window.GetWidth() / 2 - bright_logo.image.GetWidth() / 2);
bright_logo.sprite.SetY(Window.GetHeight() / 2 - bright_logo.image.GetHeight() / 2 - 40);
bright_logo.sprite.SetOpacity(1);

// Progress indicator (dots)
for (i = 0; i < 5; i++) {
    dot[i].image = Image("dot.png");
    dot[i].sprite = Sprite(dot[i].image);
    dot[i].sprite.SetX(Window.GetWidth() / 2 - 60 + i * 30);
    dot[i].sprite.SetY(Window.GetHeight() / 2 + bright_logo.image.GetHeight() / 2 + 20);
    dot[i].sprite.SetOpacity(0.3);
}

Plymouth.SetRefreshFunction(refresh_callback);
