#!/usr/bin/env python3
"""
Bright Terminal - Terminal emulator for Bright OS
A lightweight terminal emulator wrapping QTermWidget or falling back to konsole/qterminal.
"""
import sys
import os
import subprocess
from pathlib import Path

from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QTabWidget,
    QTabBar, QToolBar, QPushButton, QLabel, QHBoxLayout, QFileDialog,
    QMessageBox, QLineEdit, QSplitter
)
from PyQt6.QtCore import Qt, QProcess, QUrl, pyqtSignal
from PyQt6.QtGui import QFont, QIcon, QAction, QKeySequence, QColor, QPalette

APP_NAME = "Bright Terminal"
APP_VERSION = "0.1.0-alpha"
CONFIG_DIR = Path.home() / ".config" / "bright-os" / "terminal"


class TerminalTab(QWidget):
    """A single terminal tab using a QProcess connected to a shell"""
    
    titleChanged = pyqtSignal(str)
    closed = pyqtSignal(QWidget)
    
    def __init__(self, parent=None, working_dir=None):
        super().__init__(parent)
        self.process = QProcess(self)
        self.working_dir = working_dir or str(Path.home())
        
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        
        # Simple terminal display using a text approach (simplified)
        # In production this would use QTermWidget; we provide a working shell
        from PyQt6.QtWidgets import QPlainTextEdit
        self.display = QPlainTextEdit()
        self.display.setReadOnly(False)
        self.display.setFont(QFont("Hack", 11))
        self.display.setStyleSheet("""
            QPlainTextEdit {
                background-color: #0a0e1a;
                color: #e2e8f0;
                border: none;
                padding: 8px;
                selection-background-color: #3b82f6;
            }
        """)
        
        # Input line
        self.input = QLineEdit()
        self.input.setFont(QFont("Hack", 11))
        self.input.setStyleSheet("""
            QLineEdit {
                background-color: #0a0e1a;
                color: #e2e8f0;
                border: none;
                border-top: 1px solid #1e293b;
                padding: 6px 8px;
            }
        """)
        self.input.setPlaceholderText("Enter command...")
        self.input.returnPressed.connect(self.execute_command)
        
        # Prompt label
        self.prompt_label = QLabel()
        self.update_prompt()
        
        prompt_bar = QHBoxLayout()
        prompt_bar.setContentsMargins(8, 4, 0, 4)
        self.prompt_widget = QWidget()
        self.prompt_widget.setLayout(prompt_bar)
        self.prompt_widget.setStyleSheet("background: #0a0e1a; color:#60a5fa;")
        prompt_bar.addWidget(self.prompt_label)
        
        layout.addWidget(self.display, 1)
        layout.addWidget(self.prompt_widget)
        layout.addWidget(self.input)
        
        self.append_output(f"Bright Terminal {APP_VERSION}\n")
        self.append_output(f"Welcome to Bright OS. Type 'help' for commands.\n\n")
        
        # Start interactive shell as subprocess
        self.start_shell()
    
    def update_prompt(self):
        user = os.environ.get("USER", "user")
        host = os.uname().nodename
        cwd = os.path.basename(self.working_dir) or "/"
        if cwd == os.path.basename(str(Path.home())):
            cwd = "~"
        self.prompt_label.setText(f'<span style="color:#60a5fa">{user}@{host}</span>:<span style="color:#a78bfa">{cwd}</span>$')
    
    def append_output(self, text):
        self.display.appendPlainText(text)
        scrollbar = self.display.verticalScrollBar()
        scrollbar.setValue(scrollbar.maximum())
    
    def execute_command(self):
        cmd = self.input.text().strip()
        self.input.clear()
        
        self.append_output(f"{self.prompt_label.text().replace('<[^>]+>', '')} {cmd}")
        
        if not cmd:
            return
        
        if cmd == "exit" or cmd == "quit":
            self.closed.emit(self)
            return
        
        if cmd == "clear":
            self.display.clear()
            return
        
        if cmd == "help":
            self.append_output("Available commands:")
            self.append_output("  cd <dir>   - change directory")
            self.append_output("  clear      - clear terminal")
            self.append_output("  exit       - close terminal")
            self.append_output("  help       - show this help")
            self.append_output("  Other commands run via bash\n")
            return
        
        if cmd.startswith("cd "):
            target = cmd[3:].strip()
            if target == "~":
                target = str(Path.home())
            new_dir = Path(self.working_dir) / target
            try:
                new_dir = new_dir.resolve()
                if new_dir.is_dir():
                    self.working_dir = str(new_dir)
                    os.chdir(self.working_dir)
                    self.update_prompt()
                else:
                    self.append_output(f"cd: no such directory: {target}")
            except Exception as e:
                self.append_output(f"cd: {e}")
            return
        
        # Run command via bash
        proc = subprocess.run(
            ["bash", "-c", cmd],
            cwd=self.working_dir,
            capture_output=True, text=True,
            timeout=30
        )
        if proc.stdout:
            self.append_output(proc.stdout.rstrip())
        if proc.stderr:
            self.append_output(proc.stderr.rstrip())
        self.update_prompt()
    
    def start_shell(self):
        """For a more complete terminal, launch konsole or qterminal as fallback"""
        pass


class BrightTerminal(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.setMinimumSize(800, 500)
        self.resize(900, 600)
        
        # Dark theme by default
        self.setStyleSheet("""
            QMainWindow { background: #0a0e1a; }
            QTabWidget::pane { border: none; background: #0a0e1a; }
            QTabBar::tab {
                background: #1e293b; color: #94a3b8;
                padding: 8px 20px; border: none;
                border-top-left-radius: 8px; border-top-right-radius: 8px;
                margin-right: 2px;
            }
            QTabBar::tab:selected { background: #0a0e1a; color: #e2e8f0; }
            QTabBar::tab:hover { background: #334155; }
            QToolBar {
                background: #1e293b; border: none; spacing: 4px;
                padding: 4px;
            }
            QToolButton {
                background: transparent; color: #94a3b8; border: none;
                padding: 6px 12px; border-radius: 6px;
            }
            QToolButton:hover { background: #334155; color: #e2e8f0; }
        """)
        
        # Toolbar
        toolbar = QToolBar()
        toolbar.setMovable(False)
        self.addToolBar(toolbar)
        
        new_tab_btn = QPushButton("+ New Tab")
        new_tab_btn.clicked.connect(self.new_tab)
        toolbar.addWidget(new_tab_btn)
        
        # Tab widget
        self.tabs = QTabWidget()
        self.tabs.setDocumentMode(True)
        self.tabs.setTabsClosable(True)
        self.tabs.tabCloseRequested.connect(self.close_tab)
        self.setCentralWidget(self.tabs)
        
        # Keyboard shortcuts
        new_tab_action = QAction("New Tab", self)
        new_tab_action.setShortcut(QKeySequence("Ctrl+Shift+T"))
        new_tab_action.triggered.connect(self.new_tab)
        self.addAction(new_tab_action)
        
        close_tab_action = QAction("Close Tab", self)
        close_tab_action.setShortcut(QKeySequence("Ctrl+Shift+W"))
        close_tab_action.triggered.connect(lambda: self.close_tab(self.tabs.currentIndex()))
        self.addAction(close_tab_action)
        
        # Initial tab
        self.new_tab()
    
    def new_tab(self, working_dir=None):
        tab = TerminalTab(working_dir=working_dir)
        idx = self.tabs.addTab(tab, "Shell")
        self.tabs.setCurrentIndex(idx)
        tab.closed.connect(lambda: self.close_tab(self.tabs.indexOf(tab)))
        return tab
    
    def close_tab(self, index):
        if self.tabs.count() <= 1:
            self.close()
        else:
            self.tabs.removeTab(index)


def main():
    QApplication.setApplicationName("bright-terminal")
    QApplication.setApplicationDisplayName(APP_NAME)
    app = QApplication(sys.argv)
    
    # Try to use konsole if available (better terminal experience)
    for term in ["konsole", "qterminal", "xfce4-terminal"]:
        if subprocess.run(["which", term], capture_output=True).returncode == 0:
            os.execvp(term, [term])
            return
    
    term = BrightTerminal()
    term.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
