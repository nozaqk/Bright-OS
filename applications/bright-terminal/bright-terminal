class TerminalDisplay(QPlainTextEdit):
    """Terminal display widget that captures keystrokes and displays output"""
    
    def __init__(self, shell_cmd=None, cwd=None, parent=None):
        super().__init__(parent)
        self.setReadOnly(False)
        self.shell_cmd = shell_cmd or os.environ.get("SHELL", "/bin/bash")
        self.cwd = cwd or str(Path.home())
        
        # Font
        font = QFont("Hack,DejaVu Sans Mono,monospace", 11)
        font.setStyleHint(QFont.StyleHint.TypeWriter)
        self.setFont(font)
        
        # Colors - dark theme
        self.setStyleSheet("""
            QPlainTextEdit {
                background-color: #0a0e1a;
                color: #e2e8f0;
                border: none;
                padding: 8px;
                selection-background-color: #3b82f6;
                selection-color: #ffffff;
            }
        """)
        
        # PTY state
        self.master_fd = None
        self.slave_fd = None
        self.notifier = None
        self.prompt_pos = 0
        self.current_command = ""
        self.history = []
        self.history_index = -1
        self.tab_count = 0
        
        self.setCursorWidth(8)
        self._start_shell()
    
    def _start_shell(self):
        """Start the shell in a PTY"""
        try:
            self.master_fd, self.slave_fd = pty.openpty()
            # Set terminal size
            self._set_pty_size(24, 80)
            
            pid = os.fork()
            if pid == 0:  # Child
                os.close(self.master_fd)
                # Make this the controlling terminal
                if os.getenv("TERM") is None:
                    os.environ["TERM"] = "xterm-256color"
                os.chdir(self.cwd)
                os.setsid()
                fcntl.ioctl(self.slave_fd, termios.TIOCSCTTY, 0)
                os.dup2(self.slave_fd, 0)
                os.dup2(self.slave_fd, 1)
                os.dup2(self.slave_fd, 2)
                os.close(self.slave_fd)
                os.execvp(self.shell_cmd, [self.shell_cmd, "--noprofile", "--norc", "-i"])
                os._exit(1)
            else:  # Parent
                os.close(self.slave_fd)
                # Set non-blocking
                flags = fcntl.fcntl(self.master_fd, fcntl.F_GETFL)
                fcntl.fcntl(self.master_fd, fcntl.F_SETFL, flags | os.O_NONBLOCK)
                
                self.notifier = QSocketNotifier(self.master_fd, QSocketNotifier.Type.Read)
                self.notifier.activated.connect(self._read_from_pty)
                self.notifier.setEnabled(True)
                
                # Set initial PS1 for bash
                self._write_to_pty("export PS1='\\[\\e[34m\\]\\u@\\h\\[\\e[0m\\]:\\[\\e[35m\\]\\w\\[\\e[0m\\]\\$ '\n")
                self._write_to_pty("cd " + shlex.quote(self.cwd) + "\n")
        except Exception as e:
            self.appendPlainText(f"Error starting shell: {e}")
            self.appendPlainText("Falling back to simple command mode.")
    
    def _set_pty_size(self, rows, cols):
        """Resize the PTY"""
        if self.master_fd is not None:
            try:
                winsize = struct.pack("HHHH", rows, cols, 0, 0)
                fcntl.ioctl(self.master_fd, termios.TIOCSWINSZ, winsize)
            except Exception:
                pass
    
    def _write_to_pty(self, data):
        """Write data to the PTY master"""
        if self.master_fd is not None:
            try:
                os.write(self.master_fd, data.encode() if isinstance(data, str) else data)
            except OSError:
                pass
    
    def _read_from_pty(self):
        """Read output from PTY and display it"""
        if self.master_fd is None:
            return
        try:
            data = os.read(self.master_fd, 4096)
            if not data:
                self.notifier.setEnabled(False)
                return
            
            text = data.decode('utf-8', errors='replace')
            
            # Strip ANSI escape codes for display but keep some colors
            # Simple approach: display plain text, remove most escape sequences
            import re
            # Remove most escape sequences
            clean = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', text)
            # Remove CSI sequences
            clean = re.sub(r'\x1b\][^\x07]*(\x07|\x1b\\)', '', clean)
            
            # Move cursor to end and insert text
            cursor = self.textCursor()
            cursor.movePosition(QTextCursor.MoveOperation.End)
            cursor.insertText(clean)
            self.setTextCursor(cursor)
            self.ensureCursorVisible()
            
        except (OSError, UnicodeDecodeError):
            pass
    
    def keyPressEvent(self, event: QKeyEvent):
        """Handle key presses and send to PTY"""
        key = event.key()
        mods = event.modifiers()
        
        # Special keys
        if key == Qt.Key.Key_Return or key == Qt.Key.Key_Enter:
            self._write_to_pty("\r")
            return
        elif key == Qt.Key.Key_Backspace:
            self._write_to_pty("\x7f")
            return
        elif key == Qt.Key.Key_Tab:
            self._write_to_pty("\t")
            return
        elif key == Qt.Key.Key_Escape:
            self._write_to_pty("\x1b")
            return
        elif key == Qt.Key.Key_Up:
            self._write_to_pty("\x1b[A")
            return
        elif key == Qt.Key.Key_Down:
            self._write_to_pty("\x1b[B")
            return
        elif key == Qt.Key.Key_Right:
            self._write_to_pty("\x1b[C")
            return
        elif key == Qt.Key.Key_Left:
            self._write_to_pty("\x1b[D")
            return
        elif key == Qt.Key.Key_Home:
            self._write_to_pty("\x1b[H")
            return
        elif key == Qt.Key.Key_End:
            self._write_to_pty("\x1b[F")
            return
        elif key == Qt.Key.Key_PageUp:
            self._write_to_pty("\x1b[5~")
            return
        elif key == Qt.Key.Key_PageDown:
            self._write_to_pty("\x1b[6~")
            return
        elif key == Qt.Key.Key_Delete:
            self._write_to_pty("\x1b[3~")
            return
        elif mods & Qt.KeyboardModifier.ControlModifier:
            if key == Qt.Key.Key_C:
                self._write_to_pty("\x03")
                return
            elif key == Qt.Key.Key_D:
                self._write_to_pty("\x04")
                return
            elif key == Qt.Key.Key_L:
                self.clear()
                self._write_to_pty("\x0c")
                return
            elif key == Qt.Key.Key_Z:
                self._write_to_pty("\x1a")
                return
            elif key == Qt.Key.Key_A:
                self._write_to_pty("\x01")
                return
            elif key == Qt.Key.Key_E:
                self._write_to_pty("\x05")
                return
            elif key == Qt.Key.Key_U:
                self._write_to_pty("\x15")
                return
            elif key == Qt.Key.Key_K:
                self._write_to_pty("\x0b")
                return
            elif key == Qt.Key.Key_W:
                self._write_to_pty("\x17")
                return
        
        # Regular character
        text = event.text()
        if text:
            self._write_to_pty(text)
    
    def resizeEvent(self, event):
        super().resizeEvent(event)
        # Estimate terminal size based on widget size
        if self.master_fd is not None:
            font_metrics = self.fontMetrics()
            char_w = font_metrics.horizontalAdvance('M')
            char_h = font_metrics.height()
            cols = max(40, int(self.viewport().width() / char_w))
            rows = max(10, int(self.viewport().height() / char_h))
            self._set_pty_size(rows, cols)
    
    def close_shell(self):
        """Close the PTY"""
        if self.master_fd is not None:
            try:
                os.close(self.master_fd)
            except OSError:
                pass
            self.master_fd = None


class TerminalTab(QWidget):
    """A single terminal tab"""
    closed = pyqtSignal(QWidget)
    
    def __init__(self, cwd=None, parent=None):
        super().__init__(parent)
        layout = QVBoxLayout(self)
        layout.setContentsMargins(0, 0, 0, 0)
        layout.setSpacing(0)
        
        self.terminal = TerminalDisplay(cwd=cwd)
        layout.addWidget(self.terminal, 1)
    
    def closeEvent(self, event):
        self.terminal.close_shell()
        super().closeEvent(event)


class BrightTerminal(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.setMinimumSize(700, 450)
        self.resize(900, 600)
        
        # Dark theme
        self.setStyleSheet("""
            QMainWindow { background: #0a0e1a; }
            QTabWidget::pane { border: none; background: #0a0e1a; }
            QTabBar::tab {
                background: #1e293b; color: #94a3b8;
                padding: 8px 20px; border: none;
                border-top-left-radius: 8px; border-top-right-radius: 8px;
                margin-right: 2px;
            }
            QTabBar::tab:selected { background: #0a0e1a; color: #e2e8f0; }
            QTabBar::tab:hover { background: #334155; }
            QToolBar {
                background: #1e293b; border: none; spacing: 4px; padding: 4px;
            }
            QToolButton {
                background: transparent; color: #94a3b8; border: none;
                padding: 6px 12px; border-radius: 6px;
            }
            QToolButton:hover { background: #334155; color: #e2e8f0; }
        """)
        
        # Toolbar
        toolbar = QToolBar()
        toolbar.setMovable(False)
        self.addToolBar(toolbar)
        
        new_tab_btn = QPushButton("+ New Tab")
        new_tab_btn.setStyleSheet("background:#334155;color:#e2e8f0;border:none;border-radius:6px;padding:6px 12px;")
        new_tab_btn.clicked.connect(self.new_tab)
        toolbar.addWidget(new_tab_btn)
        
        toolbar.addSeparator()
        
        title = QLabel("Bright Terminal")
        title.setStyleSheet("color:#94a3b8;font-size:12px;padding:0 8px;")
        toolbar.addWidget(title)
        
        # Tab widget
        self.tabs = QTabWidget()
        self.tabs.setDocumentMode(True)
        self.tabs.setTabsClosable(True)
        self.tabs.tabCloseRequested.connect(self.close_tab)
        self.setCentralWidget(self.tabs)
        
        # Keyboard shortcuts
        new_tab_action = QAction("New Tab", self)
        new_tab_action.setShortcut(QKeySequence("Ctrl+Shift+T"))
        new_tab_action.triggered.connect(self.new_tab)
        self.addAction(new_tab_action)
        
        close_tab_action = QAction("Close Tab", self)
        close_tab_action.setShortcut(QKeySequence("Ctrl+Shift+W"))
        close_tab_action.triggered.connect(lambda: self.close_tab(self.tabs.currentIndex()))
        self.addAction(close_tab_action)
        
        copy_action = QAction("Copy", self)
        copy_action.setShortcut(QKeySequence("Ctrl+Shift+C"))
        self.addAction(copy_action)
        
        paste_action = QAction("Paste", self)
        paste_action.setShortcut(QKeySequence("Ctrl+Shift+V"))
        paste_action.triggered.connect(self.paste)
        self.addAction(paste_action)
        
        # Open initial tab
        self.new_tab()
    
    def new_tab(self, cwd=None):
        tab = TerminalTab(cwd=cwd or str(Path.home()))
        idx = self.tabs.addTab(tab, "Shell")
        self.tabs.setCurrentIndex(idx)
        return tab
    
    def close_tab(self, index):
        tab = self.tabs.widget(index)
        if tab:
            tab.close_shell() if hasattr(tab, 'close_shell') else None
        if self.tabs.count() <= 1:
            self.close()
        else:
            self.tabs.removeTab(index)
    
    def paste(self):
        text = QApplication.clipboard().text()
        current = self.tabs.currentWidget()
        if current and hasattr(current, 'terminal'):
            current.terminal._write_to_pty(text)


def main():
    # If a better terminal is available, use it for full PTY support
    # (Our built-in terminal is functional but konsole/qterminal have more features)
    # We prefer our built-in terminal since it's always available and themed,
    # but let users override via BRIGHT_TERMINAL_FALLBACK=1
    if os.environ.get("BRIGHT_TERMINAL_FALLBACK") == "1":
        for term in ["konsole", "qterminal", "xfce4-terminal"]:
            try:
                import shutil
                if shutil.which(term):
                    os.execvp(term, [term] + sys.argv[1:])
                    return
            except Exception:
                pass
    
    QApplication.setApplicationName("bright-terminal")
    QApplication.setApplicationDisplayName(APP_NAME)
    app = QApplication(sys.argv)
    term = BrightTerminal()
    term.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
