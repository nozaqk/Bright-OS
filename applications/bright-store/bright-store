class InstallWorker(QThread):
    done = pyqtSignal(bool, str)
    def __init__(self, pkg, source, action):
        super().__init__()
        self.pkg = pkg; self.source = source; self.action = action
    def run(self):
        try:
            if self.source == "apt":
                cmd = ["pkexec", "apt-get", "-y", "install" if self.action=="install" else "remove", self.pkg]
            else:
                cmd = ["flatpak", "-y", self.action, self.pkg]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
            self.done.emit(r.returncode == 0, r.stdout + r.stderr)
        except Exception as e:
            self.done.emit(False, str(e))


class AppListItem(QWidget):
    def __init__(self, app, store):
        super().__init__()
        self.app = app; self.store = store
        lay = QHBoxLayout(self)
        icon = QLabel("\U0001F4E6"); icon.setStyleSheet("font-size: 32px;")
        lay.addWidget(icon)
        info = QVBoxLayout()
        name = QLabel(app["name"]); name.setObjectName("appName")
        desc = QLabel(app["desc"]); desc.setObjectName("appDesc")
        tag = QLabel(app["tag"].upper()); tag.setObjectName("appTag")
        info.addWidget(name); info.addWidget(desc); info.addWidget(tag)
        lay.addLayout(info, 1)
        self.btn = QPushButton("Install")
        self.btn.clicked.connect(self.install)
        lay.addWidget(self.btn)
    
    def install(self):
        self.btn.setEnabled(False)
        self.btn.setText("Installing...")
        self.worker = InstallWorker(self.app["pkg"], self.app["source"], "install")
        self.worker.done.connect(self.done)
        self.worker.start()
    
    def done(self, ok, msg):
        self.btn.setEnabled(True)
        self.btn.setText("Installed" if ok else "Failed")
        if ok:
            self.btn.setObjectName("installed")
            self.btn.style().unpolish(self.btn); self.btn.style().polish(self.btn)


class BrightStore(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle(APP_NAME)
        self.setMinimumSize(800, 600)
        self.resize(900, 650)
        self.setStyleSheet(STYLE)
        
        central = QWidget()
        self.setCentralWidget(central)
        lay = QVBoxLayout(central)
        lay.setContentsMargins(24, 24, 24, 24)
        
        header = QLabel("Bright Store")
        header.setStyleSheet("font-size: 24px; font-weight: bold;")
        lay.addWidget(header)
        
        self.search = QLineEdit()
        self.search.setPlaceholderText("Search applications...")
        self.search.textChanged.connect(self.filter)
        lay.addWidget(self.search)
        
        self.tabs = QTabWidget()
        self.all_list = QListWidget(); self.all_list.setSpacing(0)
        self.populate_list(self.all_list, APPS)
        self.tabs.addTab(self.all_list, "All")
        
        for tag in ["Development", "Graphics", "Media", "Gaming", "Electronics"]:
            lst = QListWidget()
            self.populate_list(lst, [a for a in APPS if a["tag"] == tag])
            self.tabs.addTab(lst, tag)
        
        lay.addWidget(self.tabs)
    
    def populate_list(self, list_widget, apps):
        for app in apps:
            item = QListWidgetItem()
            item.setSizeHint(item.sizeHint().expandedTo(list_widget.sizeHintForRow(0)))
            row = AppListItem(app, self)
            item.setSizeHint(row.sizeHint())
            list_widget.addItem(item)
            list_widget.setItemWidget(item, row)
    
    def filter(self, text):
        text = text.lower()
        for i in range(self.all_list.count()):
            item = self.all_list.item(i)
            widget = self.all_list.itemWidget(item)
            item.setHidden(text != "" and text not in widget.app["name"].lower() and text not in widget.app["desc"].lower())


def main():
    QApplication.setApplicationName("bright-store")
    app = QApplication(sys.argv)
    w = BrightStore(); w.show()
    sys.exit(app.exec())


if __name__ == "__main__":
    main()
