# Bright OS Calamares Branding Descriptor
# Defines branding shown in the Calamares installer window.

---
componentName: bright-os
branding:
  productName: "Bright OS"
  version: "0.1.0-alpha"
  shortVersion: "0.1"
  versionedName: "Bright OS Alpha"
  shortProductName: "Bright"
  productUrl: "https://github.com/nozaqk/Bright-OS"
  supportUrl: "https://github.com/nozaqk/Bright-OS/issues"
  bootloaderEntryName: "Bright OS"

  strings:
    welcome: "Welcome to Bright OS"
    # Product-specific strings for Calamares UI
    next: "Next"
    back: "Back"
    install: "Install Now"
    done: "Done"
    cancel: "Cancel"

  images:
    productLogo: "bright-os-logo.svg"
    productIcon: "bright-os-logo.svg"

  style:
    sidebarBackground: "#0f172a"
    sidebarText: "#e2e8f0"
    sidebarTextSelect: "#3b82f6"
    # Match Bright Design System
    sidebarBackgroundSelected: "#3b82f6"
    sidebarTextHover: "#94a3b8"

  slideshowAPI: 1
  slideshow: "show.qml"
