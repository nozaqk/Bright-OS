# labwc theme settings for Bright OS (experimental Phase 6.1 PoC)
# Colours are chosen to be neutral so they don't clash with the Bright
# shell's own panel/dock rendering. Server-side window decorations are
# disabled for the shell's surfaces (see rc.xml window rules), so these
# values mainly affect XWayland apps that request server-side decorations.

# General
corner-radius: 8
font: sans 10

# Borders
border-width: 1
window.active.border.color: #1e293b
window.inactive.border.color: #334155
window.inactive.titlebar.color: #0f172a
window.active.titlebar.color: #0f172a
window.active.title.unfocused.color: #94a3b8

# Text
window.active.label.text.color: #f8fafc
window.inactive.label.text.color: #94a3b8
window.active.label.text.font: sans:style=Bold 10
window.inactive.label.text.font: sans 10

# Buttons (close/max/min: inherited from default; color neutral)
window.active.button.unpressed.image.color: #f8fafc
window.inactive.button.unpressed.image.color: #94a3b8

# Menu
menu.items.bg.color: #0f172a
menu.items.fg.color: #f8fafc
menu.items.active.bg.color: #2563eb
menu.items.active.fg.color: #ffffff
menu.border.color: #334155
menu.width: 240
menu.padding: 4
menu.overlap.x: 0
menu.overlap.y: 0

# OSD (window switcher)
osd.bg.color: #0f172a
osd.border.color: #2563eb
osd.border.width: 1
osd.label.text.color: #f8fafc
osd.window.active.image.color: #f8fafc
osd.window.inactive.image.color: #94a3b8
osd.window.active.label.text.color: #f8fafc
