#!/bin/sh
# Bright OS live-build auto/config
# Configures lb for building Bright OS ISOs

set -e

# Detect edition/codename from environment, with defaults
EDITION="${BRIGHT_EDITION:-home}"
ARCH="${BRIGHT_ARCH:-amd64}"
VERSION="${BRIGHT_VERSION:-0.1.0-alpha}"
CODENAME="${BRIGHT_DEBIAN_CODENAME:-trixie}"

echo "=== Configuring Bright OS ${VERSION} (${EDITION} edition, ${ARCH}, Debian ${CODENAME}) ==="

# Validate required parameters
if [ -z "${EDITION}" ] || [ -z "${ARCH}" ] || [ -z "${CODENAME}" ]; then
    echo "ERROR: EDITION, ARCH, and CODENAME must be set"
    exit 1
fi

# Security mirror URL depends on codename
case "${CODENAME}" in
    trixie|forky)
        SECURITY_URL="http://security.debian.org/debian-security"
        ;;
    bookworm)
        SECURITY_URL="http://security.debian.org/debian-security"
        ;;
    *)
        SECURITY_URL="http://security.debian.org/debian-security"
        ;;
esac

lb config noauto \
  --distribution "${CODENAME}" \
  --architecture "${ARCH}" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --parent-archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian" \
  --mirror-binary "http://deb.debian.org/debian" \
  --mirror-chroot "http://deb.debian.org/debian" \
  --mirror-chroot-security "${SECURITY_URL}" \
  --mirror-binary-security "${SECURITY_URL}" \
  --apt-recommends true \
  --apt-options "--yes --option Acquire::Retries=3" \
  --binary-images iso-hybrid \
  --iso-application "Bright OS" \
  --iso-publisher "Bright OS Project <https://github.com/nozaqk/Bright-OS>" \
  --iso-volume "Bright OS ${VERSION} ${EDITION}" \
  --iso-preparer "Bright OS live-build" \
  --checksums sha256 \
  --bootloader grub-efi \
  --efi-boot-partition-size 64 \
  --memtest none \
  --firmware-binary true \
  --firmware-chroot true \
  --win32-loader false \
  --zsync false \
  --debian-installer false \
  --swap-file-size 0 \
  "${@}"

echo "=== Configuration complete for ${EDITION} edition (Debian ${CODENAME}) ==="
