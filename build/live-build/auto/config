#!/bin/bash
# Bright OS live-build auto/config
# Configures lb for building Bright OS ISOs
#
# Detects live-build version capabilities and uses compatible options.
# Supports both modern Debian live-build (Trixie/Sid, 1:2023xxxx+) with
# --bootloaders/--uefi-secure-boot, and older versions (e.g. Ubuntu 24.04's
# 3.0~a57 fork) that use singular option names and lack Secure Boot flags.
#
# Target: Debian Trixie (amd64) with BIOS + UEFI dual boot.

set -e

# Save any extra arguments passed through (for ad-hoc overrides)
EXTRA_ARGS=("$@")

# Detect edition/codename from environment, with defaults
EDITION="${BRIGHT_EDITION:-home}"
ARCH="${BRIGHT_ARCH:-amd64}"
VERSION="${BRIGHT_VERSION:-0.1.0-alpha}"
CODENAME="${BRIGHT_DEBIAN_CODENAME:-trixie}"

echo "=== Configuring Bright OS ${VERSION} (${EDITION} edition, ${ARCH}, Debian ${CODENAME}) ==="

# Validate required parameters
if [ -z "${EDITION}" ] || [ -z "${ARCH}" ] || [ -z "${CODENAME}" ]; then
    echo "ERROR: EDITION, ARCH, and CODENAME must be set"
    exit 1
fi

# Security mirror URL
SECURITY_URL="http://security.debian.org/debian-security"

# ==============================================================================
# Live-build capability detection
# ==============================================================================
# Detect which options the installed lb config supports by checking --help.
# More reliable than version parsing because Ubuntu uses a different version
# scheme (3.0~a57) vs Debian's date-based versions (1:20250505).
# ==============================================================================

echo "Detecting live-build capabilities..."
# Capture both stdout and stderr; some versions of lb may write help to either
LB_HELP=$(lb config --help 2>&1 || true)

# Extract all --long-option names from the help text into a sorted list.
# This robustly handles any help formatting (bracketed synopsis, bold markers,
# pipe-separated alternatives, short|long combinations) by simply extracting
# every token that starts with -- followed by option-name characters.
# We then check for exact option name in this list, which avoids singular/plural
# false matches (--bootloader won't match --bootloaders because 's' is part of
# the token, and exact matching distinguishes them).
LB_OPTIONS=$(echo "$LB_HELP" | grep -oE '\-\-[a-z][a-z0-9\-]+' | sort -u)

has_option() {
    # Check if an exact --option-name was extracted from the help text.
    # Use -e to prevent patterns starting with -- from being treated as grep options.
    echo "$LB_OPTIONS" | grep -qFxe "$1"
}

# Bootloader option detection
LB_HAS_MODERN_BOOTLOADERS=false
if has_option "--bootloaders"; then
    LB_BOOTLOADERS_OPT="--bootloaders"
    LB_HAS_MODERN_BOOTLOADERS=true
    echo "  Detected modern live-build with --bootloaders (plural) support"
elif has_option "--bootloader"; then
    LB_BOOTLOADERS_OPT="--bootloader"
    LB_HAS_MODERN_BOOTLOADERS=false
    echo "  Detected legacy live-build with --bootloader (singular) support"
else
    echo "ERROR: Cannot determine bootloader option for this live-build version."
    echo "  Neither --bootloaders nor --bootloader found in 'lb config --help'."
    echo "  Please install a supported live-build version."
    exit 1
fi

# Secure Boot support
if has_option "--uefi-secure-boot"; then
    LB_HAS_SECURE_BOOT=true
    echo "  Detected --uefi-secure-boot support"
else
    LB_HAS_SECURE_BOOT=false
    echo "  WARNING: This live-build version does not support --uefi-secure-boot."
fi

# Architecture option name (--architecture vs --architectures)
if has_option "--architecture"; then
    LB_ARCH_OPT="--architecture"
elif has_option "--architectures"; then
    LB_ARCH_OPT="--architectures"
else
    LB_ARCH_OPT="-a"
    echo "  WARNING: Cannot detect --architecture/--architectures; falling back to -a"
fi

# Binary image option name
if has_option "--binary-image"; then
    LB_BINARY_IMAGE_OPT="--binary-image"
elif has_option "--binary-images"; then
    LB_BINARY_IMAGE_OPT="--binary-images"
else
    echo "ERROR: Cannot determine binary image option."
    exit 1
fi

# Parent archive areas (not present in very old versions)
if has_option "--parent-archive-areas"; then
    LB_HAS_PARENT_ARCHIVE_AREAS=true
else
    LB_HAS_PARENT_ARCHIVE_AREAS=false
    echo "  WARNING: --parent-archive-areas not supported; omitting."
fi

# Mode option: REQUIRED. Bright OS MUST always build in Debian mode to prevent
# live-build from auto-detecting Ubuntu mode based on the host's /etc/os-release.
# Without --mode debian on Ubuntu hosts, live-build produces LB_MODE=ubuntu,
# ubuntu-keyring, UBUNTU labels, and ubuntu syslinux theme — generating an
# Ubuntu derivative rather than Debian Trixie. This is a hard failure because
# we cannot guarantee a correct Debian build without explicit --mode support.
if has_option "--mode"; then
    LB_HAS_MODE=true
    echo "  Detected --mode support (forcing debian mode)"
else
    LB_HAS_MODE=false
    echo ""
    echo "ERROR: This live-build version does not support the --mode option."
    echo "  Bright OS requires live-build with --mode support to guarantee a Debian build."
    echo "  Without --mode debian, live-build may default to Ubuntu mode on Ubuntu hosts,"
    echo "  producing LB_MODE=ubuntu, ubuntu-keyring, UBUNTU labels, and Ubuntu branding."
    echo ""
    echo "  To fix this:"
    echo "    - Build on Debian 13 Trixie (recommended): install live-build from Debian repos"
    echo "    - On Ubuntu 24.04: live-build 3.0~a57-1ubuntu49 or later supports --mode"
    echo "    - Use the Docker-based build environment with a Debian Trixie base image"
    echo ""
    echo "  Build cannot proceed safely without explicit --mode debian support."
    exit 1
fi

# Keyring packages: specify debian-archive-keyring explicitly when in Debian mode.
# If unsupported, we still fail-safe (LB_HAS_KEYRING_PACKAGES=false means we
# don't pass the option, but --mode debian alone causes modern live-build to
# default to debian-archive-keyring). This is advisory, not a hard error.
if has_option "--keyring-packages"; then
    LB_HAS_KEYRING_PACKAGES=true
    echo "  Detected --keyring-packages support (using debian-archive-keyring)"
else
    LB_HAS_KEYRING_PACKAGES=false
    echo "  WARNING: --keyring-packages not supported; relying on mode-based keyring default"
fi

# ==============================================================================
# Build lb config argument list
# ==============================================================================

echo ""
echo "Building lb config arguments for detected live-build version..."

# Start with required common options
set -- \
  --distribution "${CODENAME}" \
  "${LB_ARCH_OPT}" "${ARCH}" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian" \
  --mirror-binary "http://deb.debian.org/debian" \
  --mirror-chroot "http://deb.debian.org/debian" \
  --mirror-chroot-security "${SECURITY_URL}" \
  --mirror-binary-security "${SECURITY_URL}" \
  --apt-recommends true \
  --apt-options "--yes --option Acquire::Retries=3" \
  "${LB_BINARY_IMAGE_OPT}" iso-hybrid \
  --checksums sha256 \
  --iso-application "Bright OS" \
  --iso-publisher "Bright OS Project <https://github.com/nozaqk/Bright-OS>" \
  --iso-volume "Bright OS ${VERSION} ${EDITION}" \
  --iso-preparer "Bright OS live-build" \
  --memtest none \
  --firmware-binary true \
  --firmware-chroot true \
  --win32-loader false \
  --zsync false \
  --initsystem systemd

# Force Debian mode to prevent Ubuntu host OS auto-detection
if [ "$LB_HAS_MODE" = true ]; then
    set -- "$@" --mode debian
fi

# Explicitly set Debian archive keyring (prevents ubuntu-keyring on Ubuntu hosts)
if [ "$LB_HAS_KEYRING_PACKAGES" = true ]; then
    set -- "$@" --keyring-packages debian-archive-keyring
fi

# Add parent-archive-areas if supported
if [ "$LB_HAS_PARENT_ARCHIVE_AREAS" = true ]; then
    set -- "$@" --parent-archive-areas "main contrib non-free non-free-firmware"
fi

# Debian installer option:
# - Modern live-build uses 'none' to disable; legacy accepts 'false'
# - 'false' works across all known versions.
set -- "$@" --debian-installer false

# Bootloader configuration
if [ "$LB_HAS_MODERN_BOOTLOADERS" = true ]; then
    # Modern: specify both BIOS and EFI bootloaders explicitly (comma-separated)
    set -- "$@" "${LB_BOOTLOADERS_OPT}" grub-pc,grub-efi
    echo "  Bootloaders: grub-pc,grub-efi (BIOS + UEFI explicit)"
else
    # Legacy live-build (e.g. Ubuntu 3.0~a57):
    # - For iso-hybrid images, isolinux/syslinux is always used for BIOS boot
    #   (per the manpage), but passing --bootloader grub enables GRUB setup
    #   which is needed for UEFI boot (EFI boot image generation).
    # - Verified working command: --bootloader grub produces LB_BOOTLOADER="grub"
    #   and enables both BIOS (isolinux) and UEFI (grub-efi) boot paths.
    set -- "$@" "${LB_BOOTLOADERS_OPT}" grub
    echo "  Bootloaders: grub (BIOS via isolinux + UEFI via grub-efi)"
fi

# Secure Boot configuration
if [ "$LB_HAS_SECURE_BOOT" = true ]; then
    set -- "$@" --uefi-secure-boot auto
    echo "  Secure Boot: auto (signed shim/grub if available)"
else
    echo "  Secure Boot: not configurable via lb flag"
    echo "    (shim-signed + grub-efi-amd64-signed installed in chroot;"
    echo "     for full Secure Boot, build on Debian Trixie)"
fi

# Append any extra arguments passed through to auto/config
if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
    echo "  Pass-through args: ${EXTRA_ARGS[*]}"
    set -- "$@" "${EXTRA_ARGS[@]}"
fi

# ==============================================================================
# Run lb config
# ==============================================================================

echo ""
echo "Running: lb config noauto"

lb config noauto "$@"

echo ""
echo "=== Configuration complete for ${EDITION} edition (Debian ${CODENAME}) ==="
if [ "$LB_HAS_MODERN_BOOTLOADERS" = false ]; then
    echo ""
    echo "=== LEGACY LIVE-BUILD NOTICE ==="
    echo "You are using an older live-build version (likely Ubuntu's fork)."
    echo "BIOS boot: Configured (isolinux via iso-hybrid)."
    echo "UEFI boot: Will be attempted via grub-efi packages."
    echo "IMPORTANT: If the resulting ISO does not boot on UEFI systems,"
    echo "build on Debian Trixie for full --bootloaders support, or use"
    echo "the Docker-based build environment."
fi
if [ "$LB_HAS_SECURE_BOOT" = false ]; then
    echo "Secure Boot: Cannot be configured by this host's live-build."
    echo "  The ISO will boot with Secure Boot disabled; shim-signed is"
    echo "  installed but may not be properly integrated into the EFI binary."
fi
