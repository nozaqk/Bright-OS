#!/bin/bash
# Bright OS live-build auto/config
# Configures lb for building Bright OS ISOs.
#
# Detects live-build version capabilities and uses compatible options.
# Supports both modern Debian live-build (Trixie/Sid, 1:2023xxxx+) with
# --bootloaders/--uefi-secure-boot, and older versions (e.g. Ubuntu 24.04's
# 1:20230502) that may use singular option names and lack some flags.
#
# Target: Debian Trixie (amd64) with BIOS + UEFI dual boot.
#
# Every option passed to lb config is first checked against the help text.
# Any option not present in help is skipped with a warning. This makes the
# config robust across live-build versions (Debian Trixie, Ubuntu 24.04, etc.).

set -e

EXTRA_ARGS=("$@")

EDITION="${BRIGHT_EDITION:-home}"
ARCH="${BRIGHT_ARCH:-amd64}"
VERSION="${BRIGHT_VERSION:-0.1.0-alpha}"
CODENAME="${BRIGHT_DEBIAN_CODENAME:-trixie}"

echo "=== Configuring Bright OS ${VERSION} (${EDITION} edition, ${ARCH}, Debian ${CODENAME}) ==="

if [ -z "${EDITION}" ] || [ -z "${ARCH}" ] || [ -z "${CODENAME}" ]; then
    echo "ERROR: EDITION, ARCH, and CODENAME must be set"
    exit 1
fi

SECURITY_URL="http://security.debian.org/debian-security"

# ==============================================================================
# Detect supported options by parsing lb config --help
# ==============================================================================

echo "Detecting live-build capabilities..."
LB_HELP=$(lb config --help 2>&1 || true)
LB_OPTIONS=$(echo "$LB_HELP" | grep -oE '\-\-[a-z][a-z0-9\-]+' | sort -u)

has_option() {
    echo "$LB_OPTIONS" | grep -qFxe "$1"
}

# Find option name: prefer plural, fall back to singular.
# Returns the option name on stdout.
find_option() {
    for opt in "$@"; do
        if has_option "$opt"; then
            echo "$opt"
            return 0
        fi
    done
    return 1
}

echo ""
echo "Detecting options..."
LB_BOOTLOADERS_OPT=$(find_option "--bootloaders" "--bootloader" || true)
LB_ARCH_OPT=$(find_option "--architecture" "--architectures" || echo "-a")
LB_BINARY_IMAGE_OPT=$(find_option "--binary-image" "--binary-images" || true)
LB_HAS_MODE=$(has_option "--mode" && echo true || echo false)
LB_HAS_KEYRING_PACKAGES=$(has_option "--keyring-packages" && echo true || echo false)
LB_HAS_PARENT_ARCHIVE_AREAS=$(has_option "--parent-archive-areas" && echo true || echo false)
LB_HAS_HDD_LABEL=$(has_option "--hdd-label" && echo true || echo false)
LB_HAS_UEFI_SECURE_BOOT=$(has_option "--uefi-secure-boot" && echo true || echo false)
LB_HAS_MEMTEST=$(has_option "--memtest" && echo true || echo false)
LB_HAS_FIRMWARE_BINARY=$(has_option "--firmware-binary" && echo true || echo false)
LB_HAS_FIRMWARE_CHROOT=$(has_option "--firmware-chroot" && echo true || echo false)
LB_HAS_WIN32_LOADER=$(has_option "--win32-loader" && echo true || echo false)
LB_HAS_ZSYNC=$(has_option "--zsync" && echo true || echo false)
LB_HAS_INITSYSTEM=$(has_option "--initsystem" && echo true || echo false)
LB_HAS_DEBIAN_INSTALLER=$(has_option "--debian-installer" && echo true || echo false)
LB_HAS_APT_RECOMMENDS=$(has_option "--apt-recommends" && echo true || echo false)
LB_CHECKSUM_OPT=$(find_option "--checksums" "--checksum" || true)
if [ -n "$LB_CHECKSUM_OPT" ]; then
    LB_HAS_CHECKSUM=true
else
    LB_HAS_CHECKSUM=false
fi
LB_HAS_ISO_APPLICATION=$(has_option "--iso-application" && echo true || echo false)
LB_HAS_ISO_PUBLISHER=$(has_option "--iso-publisher" && echo true || echo false)
LB_HAS_ISO_VOLUME=$(has_option "--iso-volume" && echo true || echo false)
LB_HAS_ISO_PREPARER=$(has_option "--iso-preparer" && echo true || echo false)

# --mode is REQUIRED; fail if not present.
if [ "$LB_HAS_MODE" != "true" ]; then
    echo ""
    echo "ERROR: This live-build version does not support the --mode option."
    echo "  Bright OS requires live-build with --mode support to guarantee a Debian build."
    echo "  Without --mode debian, live-build may default to Ubuntu mode on Ubuntu hosts,"
    echo "  producing LB_MODE=ubuntu, ubuntu-keyring, UBUNTU labels, and Ubuntu branding."
    echo ""
    echo "  To fix this:"
    echo "    - Build on Debian 13 Trixie (recommended): install live-build from Debian repos"
    echo "    - On Ubuntu 24.04: use live-build 3.0~a57-1ubuntu49 or later which supports --mode"
    echo "    - Use a Debian Trixie VM or container for building"
    echo ""
    echo "  Build cannot proceed safely without explicit --mode debian support."
    exit 1
fi
echo "  --mode supported (forcing debian mode)"

# --binary-image is required; fail if not present.
if [ -z "$LB_BINARY_IMAGE_OPT" ]; then
    echo "ERROR: Cannot determine binary image option (--binary-image or --binary-images)."
    exit 1
fi
echo "  binary image option: $LB_BINARY_IMAGE_OPT"
echo "  architecture option: $LB_ARCH_OPT"
echo "  bootloader option:   $LB_BOOTLOADERS_OPT"

# ==============================================================================
# Build lb config argument list. Each option is added only if the capability
# detection confirmed it exists, so we never pass an unsupported flag.
# ==============================================================================

echo ""
echo "Building lb config arguments..."

set -- \
  --distribution "${CODENAME}" \
  "${LB_ARCH_OPT}" "${ARCH}" \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian" \
  --mirror-binary "http://deb.debian.org/debian" \
  --mirror-chroot "http://deb.debian.org/debian" \
  --mirror-chroot-security "${SECURITY_URL}" \
  --mirror-binary-security "${SECURITY_URL}" \
  --apt-options "--yes --option Acquire::Retries=3"

# ==============================================================================
# Work around Debian Trixie security suite naming on older live-build
#
# live-build versions before 1:20240420 (including the 3.0~a57 shipped on
# Ubuntu 24.04 GitHub runners) hardcode the legacy "<codename>/updates"
# suite path for the security pocket. Since Debian 12 Bookworm the correct
# security suite is "<codename>-security" (e.g. "trixie-security"); the
# old "trixie/updates" path returns 404.
#
# Fix: when live-build supports --security/--updates toggles, disable the
# auto-generated security entry and supply our own with the correct suite
# name via config/archives/. The archives file is written BEFORE lb config
# runs so live-build picks it up.
# ==============================================================================
LB_HAS_SECURITY_TOGGLE=false
if has_option "--security"; then
    LB_HAS_SECURITY_TOGGLE=true
fi

if [ "$LB_HAS_SECURITY_TOGGLE" = "true" ] && [ "${CODENAME}" != "bullseye" ] && [ "${CODENAME}" != "buster" ]; then
    set -- "$@" --security false
    echo "  (--security false: writing manual trixie-security source via config/archives/)"
    mkdir -p config/archives
    cat > config/archives/bright-security.list.chroot <<EOF
deb ${SECURITY_URL} ${CODENAME}-security main contrib non-free non-free-firmware
EOF
    cp config/archives/bright-security.list.chroot config/archives/bright-security.list.binary
else
    echo "  (security: using live-build default)"
fi

# Conditionally add options
if [ "$LB_HAS_APT_RECOMMENDS" = "true" ]; then
    set -- "$@" --apt-recommends true
fi
set -- "$@" "${LB_BINARY_IMAGE_OPT}" iso-hybrid
# Always request sha256 checksums. The option has existed since ~2010 in live-build.
# If a singular --checksum option exists instead, use that; otherwise use --checksums.
if [ "$LB_HAS_CHECKSUM" = "true" ]; then
    set -- "$@" --checksums sha256
fi
if [ "$LB_HAS_ISO_APPLICATION" = "true" ]; then
    set -- "$@" --iso-application "Bright OS"
fi
if [ "$LB_HAS_ISO_PUBLISHER" = "true" ]; then
    set -- "$@" --iso-publisher "Bright OS Project <https://github.com/nozaqk/Bright-OS>"
fi
if [ "$LB_HAS_ISO_VOLUME" = "true" ]; then
    set -- "$@" --iso-volume "Bright OS ${VERSION} ${EDITION}"
fi
if [ "$LB_HAS_ISO_PREPARER" = "true" ]; then
    set -- "$@" --iso-preparer "Bright OS live-build"
fi
if [ "$LB_HAS_MEMTEST" = "true" ]; then
    set -- "$@" --memtest none
fi
if [ "$LB_HAS_FIRMWARE_BINARY" = "true" ]; then
    set -- "$@" --firmware-binary true
fi
if [ "$LB_HAS_FIRMWARE_CHROOT" = "true" ]; then
    set -- "$@" --firmware-chroot true
fi
if [ "$LB_HAS_WIN32_LOADER" = "true" ]; then
    set -- "$@" --win32-loader false
fi
if [ "$LB_HAS_ZSYNC" = "true" ]; then
    set -- "$@" --zsync false
fi
if [ "$LB_HAS_INITSYSTEM" = "true" ]; then
    set -- "$@" --initsystem systemd
fi
if [ "$LB_HAS_DEBIAN_INSTALLER" = "true" ]; then
    set -- "$@" --debian-installer false
fi

# Force Debian mode (required).
set -- "$@" --mode debian

# Keyring packages for Debian archive verification.
if [ "$LB_HAS_KEYRING_PACKAGES" = "true" ]; then
    set -- "$@" --keyring-packages debian-archive-keyring
    echo "  Using debian-archive-keyring"
fi

if [ "$LB_HAS_PARENT_ARCHIVE_AREAS" = "true" ]; then
    set -- "$@" --parent-archive-areas "main contrib non-free non-free-firmware"
fi

if [ "$LB_HAS_HDD_LABEL" = "true" ]; then
    set -- "$@" --hdd-label "BRIGHT_OS"
fi

# Bootloader configuration. Pass the right option and value.
if [ -n "$LB_BOOTLOADERS_OPT" ]; then
    if [ "$LB_BOOTLOADERS_OPT" = "--bootloaders" ]; then
        set -- "$@" --bootloaders grub-pc,grub-efi
        echo "  Bootloaders: grub-pc,grub-efi (plural form)"
    else
        set -- "$@" --bootloader grub
        echo "  Bootloaders: grub (singular form; BIOS via isolinux + UEFI via grub-efi)"
    fi
else
    echo "ERROR: No bootloader option detected."
    exit 1
fi

# Secure Boot: only enable if the option exists. Pass 'auto' when supported.
if [ "$LB_HAS_UEFI_SECURE_BOOT" = "true" ]; then
    set -- "$@" --uefi-secure-boot auto
    echo "  Secure Boot: auto (signed shim/grub if available)"
else
    echo "  Secure Boot: option not detected; shim-signed is installed in chroot"
    echo "    but may not be integrated into the EFI binary. The 30-efi-boot-setup"
    echo "    hook will attempt to create an EFI image via grub-mkstandalone."
fi

if [ "$LB_HAS_HDD_LABEL" = "true" ]; then
    echo "  HDD label: BRIGHT_OS (custom Bright OS label)"
else
    echo "  WARNING: --hdd-label not supported; using live-build default HDD label"
    echo "  HDD label: using live-build default (--hdd-label unsupported)"
fi

if [ ${#EXTRA_ARGS[@]} -gt 0 ]; then
    echo "  Pass-through args: ${EXTRA_ARGS[*]}"
    set -- "$@" "${EXTRA_ARGS[@]}"
fi

# ==============================================================================
# Run lb config
# ==============================================================================

echo ""
echo "Running: lb config noauto"
echo ""

# Capture output but also print it; save exit status.
set +e
lb config noauto "$@" 2>&1
LB_CONFIG_STATUS=$?
set -e

if [ "$LB_CONFIG_STATUS" -ne 0 ]; then
    echo ""
    echo "ERROR: lb config failed with exit code ${LB_CONFIG_STATUS}."
    echo "Review the output above for E: lines or unrecognized option errors."
    echo ""
    echo "Live-build version:"
    lb --version 2>&1 || true
    exit "$LB_CONFIG_STATUS"
fi

echo ""
echo "=== Configuration complete for ${EDITION} edition (Debian ${CODENAME}) ==="
if [ "$LB_HAS_UEFI_SECURE_BOOT" != "true" ] || [ "$LB_BOOTLOADERS_OPT" = "--bootloader" ]; then
    echo ""
    echo "=== NOTICE: Running on an older/legacy live-build ==="
    echo "BIOS boot: Configured."
    echo "UEFI boot: Will be attempted; if missing the hook will try grub-mkstandalone."
    echo "For best results build on Debian Trixie for full --bootloaders support."
fi
